{
  "id": "sec-b1",
  "jlptLevel": "B1",
  "tier": "Intermediate",
  "title": "CEFR B1 — Real-World Fluency",
  "description": "Opinions, subjunctive intro, por vs. para, storytelling (imperfect vs. preterite), work & connectors.",
  "color": "#f59e0b",
  "units": [
    {
      "id": "es-b1-u1",
      "title": "Opinions & Discussions",
      "subtitle": "Opiniones · Agreeing, disagreeing, and weighing pros & cons",
      "cefrLevel": "B1",
      "color": "#f59e0b",
      "lessons": [
        {
          "id": "es-b1-u1-l1",
          "title": "Sharing Viewpoints",
          "objective": "State your views clearly and invite others' opinions.",
          "grammarNote": "Affirmative 'Creo que...' takes indicative; negative 'No creo que...' triggers the subjunctive.",
          "items": [
            {
              "id": "es_b1_creo_que",
              "term": "Creo que",
              "transliteration": "KREH-oh keh",
              "translation": "I think / believe that",
              "tags": [
                "B1",
                "opinion"
              ],
              "example": {
                "term": "Creo que este diseño es más limpio.",
                "translation": "I think this design is cleaner."
              }
            },
            {
              "id": "es_b1_me_parece",
              "term": "Me parece que",
              "transliteration": "meh pah-REH-seh keh",
              "translation": "It seems to me that",
              "tags": [
                "B1",
                "opinion"
              ],
              "example": {
                "term": "Me parece que funciona muy bien.",
                "translation": "It seems to me that it works very well."
              }
            },
            {
              "id": "es_b1_de_acuerdo",
              "term": "Estar de acuerdo",
              "transliteration": "ehs-TAHR deh ah-KWEHR-doh",
              "translation": "To agree",
              "tags": [
                "B1",
                "opinion"
              ],
              "example": {
                "term": "Estoy de acuerdo con tu idea.",
                "translation": "I agree with your idea."
              }
            },
            {
              "id": "es_b1_punto_vista",
              "term": "El punto de vista",
              "transliteration": "ehl POON-toh deh BEES-tah",
              "translation": "Point of view",
              "tags": [
                "B1",
                "opinion"
              ],
              "example": {
                "term": "Desde mi punto de vista, es ideal.",
                "translation": "From my point of view, it's ideal."
              }
            },
            {
              "id": "es_b1_ventaja",
              "term": "La ventaja",
              "transliteration": "lah behn-TAH-hah",
              "translation": "Advantage",
              "tags": [
                "B1",
                "noun"
              ],
              "example": {
                "term": "Su mayor ventaja es el uso sin conexión.",
                "translation": "Its biggest advantage is offline use."
              }
            }
          ]
        },
        {
          "id": "es-b1-u1-l2",
          "title": "Feelings & Reactions",
          "objective": "Express surprise, relief, and excitement naturally.",
          "grammarNote": "Verbs of emotion followed by 'que' trigger the subjunctive when the subject changes: Me alegra que vengas.",
          "items": [
            {
              "id": "es_b1_me_alegra",
              "term": "Me alegra que",
              "transliteration": "meh ah-LEH-grah keh",
              "translation": "I'm glad that ...",
              "tags": [
                "B1",
                "emotion"
              ],
              "example": {
                "term": "Me alegra que te guste el resultado.",
                "translation": "I'm glad you like the result."
              }
            },
            {
              "id": "es_b1_me_sorprende",
              "term": "Me sorprende",
              "transliteration": "meh sohr-PREHN-deh",
              "translation": "It surprises me",
              "tags": [
                "B1",
                "emotion"
              ],
              "example": {
                "term": "Me sorprende lo ligera que es la app.",
                "translation": "I'm surprised how light the app is."
              }
            },
            {
              "id": "es_b1_preocupar",
              "term": "Preocuparse",
              "transliteration": "preh-oh-koo-PAHR-seh",
              "translation": "To worry",
              "tags": [
                "B1",
                "emotion"
              ],
              "example": {
                "term": "No te preocupes por los errores.",
                "translation": "Don't worry about mistakes."
              }
            },
            {
              "id": "es_b1_orgulloso",
              "term": "Orgulloso",
              "transliteration": "ohr-goo-YOH-soh",
              "translation": "Proud",
              "tags": [
                "B1",
                "emotion"
              ],
              "example": {
                "term": "Estoy orgulloso de mi progreso.",
                "translation": "I am proud of my progress."
              }
            },
            {
              "id": "es_b1_confianza",
              "term": "La confianza",
              "transliteration": "lah kohn-FYAHN-sah",
              "translation": "Confidence / Trust",
              "tags": [
                "B1",
                "noun"
              ],
              "example": {
                "term": "Hablar cada día da confianza.",
                "translation": "Speaking daily builds confidence."
              }
            }
          ]
        },
        {
          "id": "es-b1-u1-l3",
          "title": "Pros, Cons & Choices",
          "objective": "Compare options and explain trade-offs.",
          "grammarNote": "Contrast 'por un lado' (on one hand) with 'por otro lado' (on the other hand).",
          "items": [
            {
              "id": "es_b1_por_un_lado",
              "term": "Por un lado",
              "transliteration": "pohr oon LAH-doh",
              "translation": "On one hand",
              "tags": [
                "B1",
                "connector"
              ],
              "example": {
                "term": "Por un lado es simple; por otro, potente.",
                "translation": "On one hand it's simple; on the other, powerful."
              }
            },
            {
              "id": "es_b1_desventaja",
              "term": "La desventaja",
              "transliteration": "lah dehs-behn-TAH-hah",
              "translation": "Disadvantage",
              "tags": [
                "B1",
                "noun"
              ],
              "example": {
                "term": "Analizamos ventajas y desventajas.",
                "translation": "We analyzed pros and cons."
              }
            },
            {
              "id": "es_b1_valer",
              "term": "Valer la pena",
              "transliteration": "bah-LEHR lah PEH-nah",
              "translation": "To be worth it",
              "tags": [
                "B1",
                "idiom"
              ],
              "example": {
                "term": "El esfuerzo siempre vale la pena.",
                "translation": "The effort is always worth it."
              }
            },
            {
              "id": "es_b1_elegir",
              "term": "Elegir",
              "transliteration": "eh-leh-HEER",
              "translation": "To choose",
              "tags": [
                "B1",
                "verb"
              ],
              "example": {
                "term": "Puedes elegir entre tres idiomas.",
                "translation": "You can choose among three languages."
              }
            },
            {
              "id": "es_b1_razon",
              "term": "Tener razón",
              "transliteration": "teh-NEHR rah-SOHN",
              "translation": "To be right",
              "tags": [
                "B1",
                "phrase"
              ],
              "example": {
                "term": "Tienes toda la razón.",
                "translation": "You are completely right."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-b1-u2",
      "title": "Subjunctive Essentials",
      "subtitle": "El subjuntivo · Wishes, recommendations, doubt, and probability",
      "cefrLevel": "B1",
      "color": "#f97316",
      "lessons": [
        {
          "id": "es-b1-u2-l1",
          "title": "Wishes & Hopes",
          "objective": "Express hopes with Ojalá and Espero que.",
          "grammarNote": "Present subjunctive swaps endings: -ar verbs take -e (hable), -er/-ir verbs take -a (coma, viva).",
          "items": [
            {
              "id": "es_b1_ojala",
              "term": "Ojalá",
              "transliteration": "oh-hah-LAH",
              "translation": "Hopefully / I hope",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Ojalá aprendas mucho este año.",
                "translation": "Hopefully you learn a lot this year."
              }
            },
            {
              "id": "es_b1_espero_que",
              "term": "Espero que",
              "transliteration": "ehs-PEH-roh keh",
              "translation": "I hope that ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Espero que el curso te ayude.",
                "translation": "I hope the course helps you."
              }
            },
            {
              "id": "es_b1_quiero_que",
              "term": "Quiero que",
              "transliteration": "KYEH-roh keh",
              "translation": "I want (someone) to ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Quiero que sea accesible para todos.",
                "translation": "I want it to be accessible to everyone."
              }
            },
            {
              "id": "es_b1_desear",
              "term": "Desear",
              "transliteration": "deh-seh-AHR",
              "translation": "To wish",
              "tags": [
                "B1",
                "verb"
              ],
              "example": {
                "term": "Te deseo mucho éxito.",
                "translation": "I wish you great success."
              }
            },
            {
              "id": "es_b1_suerte",
              "term": "¡Mucha suerte!",
              "transliteration": "MOO-chah SWEHR-teh",
              "translation": "Good luck!",
              "tags": [
                "B1",
                "phrase"
              ],
              "example": {
                "term": "¡Mucha suerte en tu examen DELE!",
                "translation": "Good luck on your DELE exam!"
              }
            }
          ]
        },
        {
          "id": "es-b1-u2-l2",
          "title": "Advice & Necessity",
          "objective": "Use impersonal expressions like 'Es importante que...'.",
          "grammarNote": "Impersonal evaluations + que + subjunctive: Es necesario que practiques.",
          "items": [
            {
              "id": "es_b1_es_importante",
              "term": "Es importante que",
              "transliteration": "ehs eem-pohr-TAHN-teh keh",
              "translation": "It is important that ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Es importante que repases a diario.",
                "translation": "It is important that you review daily."
              }
            },
            {
              "id": "es_b1_recomiendo",
              "term": "Te recomiendo que",
              "transliteration": "teh reh-koh-MYEHN-doh keh",
              "translation": "I recommend that you ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Te recomiendo que escuches el audio.",
                "translation": "I recommend you listen to the audio."
              }
            },
            {
              "id": "es_b1_hace_falta",
              "term": "Hace falta que",
              "transliteration": "AH-seh FAHL-tah keh",
              "translation": "It is necessary that ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "No hace falta que pagues nada.",
                "translation": "You don't need to pay anything."
              }
            },
            {
              "id": "es_b1_conviene",
              "term": "Conviene que",
              "transliteration": "kohn-BYEH-neh keh",
              "translation": "It is advisable that ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Conviene que exportes tu progreso.",
                "translation": "It's advisable to export your progress."
              }
            },
            {
              "id": "es_b1_consejo",
              "term": "El consejo",
              "transliteration": "ehl kohn-SEH-hoh",
              "translation": "Advice / Tip",
              "tags": [
                "B1",
                "noun"
              ],
              "example": {
                "term": "Gracias por tu buen consejo.",
                "translation": "Thank you for your good advice."
              }
            }
          ]
        },
        {
          "id": "es-b1-u2-l3",
          "title": "Doubt & Possibility",
          "objective": "Express uncertainty with Quizás, Tal vez, and Dudo que.",
          "grammarNote": "'Dudo que' and 'No creo que' always take the subjunctive.",
          "items": [
            {
              "id": "es_b1_quizas",
              "term": "Quizás",
              "transliteration": "kee-SAHS",
              "translation": "Perhaps / Maybe",
              "tags": [
                "B1",
                "adverb"
              ],
              "example": {
                "term": "Quizás añadamos coreano después.",
                "translation": "Perhaps we'll add Korean later."
              }
            },
            {
              "id": "es_b1_tal_vez",
              "term": "Tal vez",
              "transliteration": "tahl behs",
              "translation": "Maybe / Perhaps",
              "tags": [
                "B1",
                "adverb"
              ],
              "example": {
                "term": "Tal vez sea mejor simplificarlo.",
                "translation": "Maybe it's better to simplify it."
              }
            },
            {
              "id": "es_b1_dudo_que",
              "term": "Dudo que",
              "transliteration": "DOO-doh keh",
              "translation": "I doubt that ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Dudo que haya algún error.",
                "translation": "I doubt there is any error."
              }
            },
            {
              "id": "es_b1_puede_que",
              "term": "Puede que",
              "transliteration": "PWEH-deh keh",
              "translation": "It may be that ...",
              "tags": [
                "B1",
                "subjunctive"
              ],
              "example": {
                "term": "Puede que llueva esta tarde.",
                "translation": "It may rain this afternoon."
              }
            },
            {
              "id": "es_b1_seguro",
              "term": "Seguro que",
              "transliteration": "seh-GOO-roh keh",
              "translation": "Surely / I'm sure that",
              "tags": [
                "B1",
                "phrase"
              ],
              "example": {
                "term": "Seguro que lo logras pronto.",
                "translation": "I'm sure you'll achieve it soon."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-b1-u3",
      "title": "Por vs. Para & Deadlines",
      "subtitle": "Por y para · Mastering Spanish's trickiest preposition pair",
      "cefrLevel": "B1",
      "color": "#ea580c",
      "lessons": [
        {
          "id": "es-b1-u3-l1",
          "title": "Uses of Para",
          "objective": "Use 'para' for purpose, recipients, destinations, and deadlines.",
          "grammarNote": "Remember PARA = Purpose, Audience/Recipient, Reach (destination), and Alarm (deadline).",
          "items": [
            {
              "id": "es_b1_para_inf",
              "term": "Para + infinitivo",
              "transliteration": "PAH-rah",
              "translation": "In order to (purpose)",
              "tags": [
                "B1",
                "grammar"
              ],
              "example": {
                "term": "Estudio para comunicarme mejor.",
                "translation": "I study in order to communicate better."
              }
            },
            {
              "id": "es_b1_para_manana",
              "term": "Para mañana",
              "transliteration": "PAH-rah mah-NYAH-nah",
              "translation": "By tomorrow (deadline)",
              "tags": [
                "B1",
                "grammar"
              ],
              "example": {
                "term": "La tarea es para el viernes.",
                "translation": "The task is due by Friday."
              }
            },
            {
              "id": "es_b1_para_mi",
              "term": "Para mí",
              "transliteration": "PAH-rah mee",
              "translation": "For me / In my opinion",
              "tags": [
                "B1",
                "grammar"
              ],
              "example": {
                "term": "Para mí, el modo oscuro es cómodo.",
                "translation": "For me, dark mode is comfortable."
              }
            },
            {
              "id": "es_b1_salir_para",
              "term": "Salir para",
              "transliteration": "sah-LEER PAH-rah",
              "translation": "To leave for (destination)",
              "tags": [
                "B1",
                "grammar"
              ],
              "example": {
                "term": "Salimos para Madrid a las siete.",
                "translation": "We leave for Madrid at seven."
              }
            },
            {
              "id": "es_b1_util_para",
              "term": "Útil para",
              "transliteration": "OO-teel PAH-rah",
              "translation": "Useful for",
              "tags": [
                "B1",
                "grammar"
              ],
              "example": {
                "term": "Es muy útil para viajeros.",
                "translation": "It is very useful for travelers."
              }
            }
          ]
        },
        {
          "id": "es-b1-u3-l2",
          "title": "Uses of Por",
          "objective": "Use 'por' for cause, duration, exchange, and movement through.",
          "grammarNote": "Remember POR = Cause/Reason, Duration, Exchange (price), and Means (por correo).",
          "items": [
            {
              "id": "es_b1_por_ejemplo",
              "term": "Por ejemplo",
              "transliteration": "pohr eh-HEHM-ploh",
              "translation": "For example",
              "tags": [
                "B1",
                "connector"
              ],
              "example": {
                "term": "Por ejemplo, puedes exportar un archivo.",
                "translation": "For example, you can export a file."
              }
            },
            {
              "id": "es_b1_por_eso",
              "term": "Por eso",
              "transliteration": "pohr EH-soh",
              "translation": "That's why / Therefore",
              "tags": [
                "B1",
                "connector"
              ],
              "example": {
                "term": "Es libre; por eso crece rápido.",
                "translation": "It's free; that's why it grows fast."
              }
            },
            {
              "id": "es_b1_por_fin",
              "term": "Por fin",
              "transliteration": "pohr feen",
              "translation": "Finally / At last",
              "tags": [
                "B1",
                "phrase"
              ],
              "example": {
                "term": "¡Por fin pasé la prueba de nivel!",
                "translation": "I finally passed the placement quiz!"
              }
            },
            {
              "id": "es_b1_por_supuesto",
              "term": "Por supuesto",
              "transliteration": "pohr soo-PWEHS-toh",
              "translation": "Of course",
              "tags": [
                "B1",
                "phrase"
              ],
              "example": {
                "term": "—¿Puedo contribuir? —¡Por supuesto!",
                "translation": "—Can I contribute? —Of course!"
              }
            },
            {
              "id": "es_b1_por_cierto",
              "term": "Por cierto",
              "transliteration": "pohr SYEHR-toh",
              "translation": "By the way",
              "tags": [
                "B1",
                "connector"
              ],
              "example": {
                "term": "Por cierto, ¿probaste el modo claro?",
                "translation": "By the way, did you try light mode?"
              }
            }
          ]
        },
        {
          "id": "es-b1-u3-l3",
          "title": "Time & Sequences",
          "objective": "Anchor events with desde, hace, and mientras.",
          "grammarNote": "'Desde hace + time' means 'for [duration] (and still ongoing)': Estudio español desde hace un año.",
          "items": [
            {
              "id": "es_b1_desde_hace",
              "term": "Desde hace",
              "transliteration": "DEHS-deh AH-seh",
              "translation": "For (ongoing duration)",
              "tags": [
                "B1",
                "time"
              ],
              "example": {
                "term": "Uso esta app desde hace un mes.",
                "translation": "I've been using this app for a month."
              }
            },
            {
              "id": "es_b1_durante",
              "term": "Durante",
              "transliteration": "doo-RAHN-teh",
              "translation": "During / For",
              "tags": [
                "B1",
                "time"
              ],
              "example": {
                "term": "Estudié durante veinte minutos.",
                "translation": "I studied for twenty minutes."
              }
            },
            {
              "id": "es_b1_antes_de",
              "term": "Antes de",
              "transliteration": "AHN-tehs deh",
              "translation": "Before",
              "tags": [
                "B1",
                "time"
              ],
              "example": {
                "term": "Repasa antes de dormir.",
                "translation": "Review before sleeping."
              }
            },
            {
              "id": "es_b1_despues_de",
              "term": "Después de",
              "transliteration": "dehs-PWEHS deh",
              "translation": "After",
              "tags": [
                "B1",
                "time"
              ],
              "example": {
                "term": "Después de cenar leo un poco.",
                "translation": "After dinner I read a little."
              }
            },
            {
              "id": "es_b1_al_final",
              "term": "Al final",
              "transliteration": "ahl fee-NAHL",
              "translation": "In the end / Finally",
              "tags": [
                "B1",
                "time"
              ],
              "example": {
                "term": "Al final todo salió perfecto.",
                "translation": "In the end everything turned out great."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-b1-u4",
      "title": "Storytelling & Past Contrast",
      "subtitle": "Narración · Preterite vs. Imperfect in real stories",
      "cefrLevel": "B1",
      "color": "#d97706",
      "lessons": [
        {
          "id": "es-b1-u4-l1",
          "title": "Setting the Scene (Imperfect)",
          "objective": "Describe childhood habits and background details.",
          "grammarNote": "Imperfect (-aba / -ía) paints the background, age, time, and 'used to' habits.",
          "items": [
            {
              "id": "es_b1_solia",
              "term": "Solía",
              "transliteration": "soh-LEE-ah",
              "translation": "I used to ...",
              "tags": [
                "B1",
                "imperfect"
              ],
              "example": {
                "term": "De niño solía dibujar mapas.",
                "translation": "As a child I used to draw maps."
              }
            },
            {
              "id": "es_b1_mientras",
              "term": "Mientras",
              "transliteration": "MYEHN-trahs",
              "translation": "While",
              "tags": [
                "B1",
                "story"
              ],
              "example": {
                "term": "Mientras caminaba, escuchaba audio.",
                "translation": "While I was walking, I listened to audio."
              }
            },
            {
              "id": "es_b1_era",
              "term": "Era / Estaba",
              "transliteration": "EH-rah",
              "translation": "Was (background)",
              "tags": [
                "B1",
                "imperfect"
              ],
              "example": {
                "term": "Era una tarde tranquila de otoño.",
                "translation": "It was a quiet autumn afternoon."
              }
            },
            {
              "id": "es_b1_habia",
              "term": "Había",
              "transliteration": "ah-BEE-ah",
              "translation": "There was / There were",
              "tags": [
                "B1",
                "imperfect"
              ],
              "example": {
                "term": "Había mucha gente en la feria.",
                "translation": "There were many people at the fair."
              }
            },
            {
              "id": "es_b1_cuando_nino",
              "term": "Cuando era niño",
              "transliteration": "KWAHN-doh EH-rah NEE-nyoh",
