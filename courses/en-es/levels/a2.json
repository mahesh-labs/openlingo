              "id": "es_a2_retraso",
              "term": "El retraso",
              "transliteration": "ehl reh-TRAH-soh",
              "translation": "Delay",
              "tags": [
                "A2",
                "travel"
              ],
              "example": {
                "term": "El tren tiene un ligero retraso.",
                "translation": "The train has a slight delay."
              }
            },
            {
              "id": "es_a2_llegar",
              "term": "Llegar",
              "transliteration": "yeh-GAHR",
              "translation": "To arrive",
              "tags": [
                "A2",
                "verb"
              ],
              "example": {
                "term": "Llegamos al destino sin problemas.",
                "translation": "We arrived at the destination smoothly."
