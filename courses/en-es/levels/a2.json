{
  "id": "sec-a2",
  "jlptLevel": "A2",
  "tier": "Elementary",
  "title": "CEFR A2 — Everyday Life",
  "description": "Reflexive routines, hobbies & gustar, travel & directions, home & health, past preterite & near-future plans.",
  "color": "#3b82f6",
  "units": [
    {
      "id": "es-a2-u1",
      "title": "Daily Routines & Reflexives",
      "subtitle": "La rutina diaria · Reflexive verbs from morning to night",
      "cefrLevel": "A2",
      "color": "#3b82f6",
      "lessons": [
        {
          "id": "es-a2-u1-l1",
          "title": "Morning Routine",
          "objective": "Use reflexive pronouns (me, te, se) naturally.",
          "grammarNote": "Place reflexive pronouns before conjugated verbs: me despierto (I wake up), me ducho (I shower).",
          "items": [
            {
              "id": "es_a2_despertarse",
              "term": "Despertarse",
              "transliteration": "dehs-pehr-TAHR-seh",
              "translation": "To wake up",
              "tags": [
                "A2",
                "reflexive"
              ],
              "example": {
                "term": "Me despierto a las seis y media.",
                "translation": "I wake up at 6:30."
              }
            },
            {
              "id": "es_a2_levantarse",
              "term": "Levantarse",
              "transliteration": "leh-bahn-TAHR-seh",
              "translation": "To get up",
              "tags": [
                "A2",
                "reflexive"
              ],
              "example": {
                "term": "Me levanto enseguida.",
                "translation": "I get up right away."
              }
            },
            {
              "id": "es_a2_ducharse",
              "term": "Ducharse",
              "transliteration": "doo-CHAHR-seh",
              "translation": "To take a shower",
              "tags": [
                "A2",
                "reflexive"
              ],
              "example": {
                "term": "Me ducho con agua fresca.",
                "translation": "I shower with cool water."
              }
            },
            {
              "id": "es_a2_desayunar",
              "term": "Desayunar",
              "transliteration": "deh-sah-yoo-NAHR",
              "translation": "To eat breakfast",
              "tags": [
                "A2",
                "routine"
              ],
              "example": {
                "term": "Desayuno fruta y avena.",
                "translation": "I have fruit and oats for breakfast."
              }
            },
            {
              "id": "es_a2_vestirse",
              "term": "Vestirse",
              "transliteration": "behs-TEER-seh",
              "translation": "To get dressed",
              "tags": [
                "A2",
                "reflexive"
              ],
              "example": {
                "term": "Me visto rápido para salir.",
                "translation": "I get dressed quickly to head out."
              }
            }
          ]
        },
        {
          "id": "es-a2-u1-l2",
          "title": "Afternoon & Evening",
          "objective": "Describe dinner, relaxing, and bedtime habits.",
          "grammarNote": "Stem-changing verbs shift their vowel in present tense: acostarse → me acuesto.",
          "items": [
            {
              "id": "es_a2_almorzar",
              "term": "Almorzar",
              "transliteration": "ahl-mohr-SAHR",
              "translation": "To have lunch",
              "tags": [
                "A2",
                "routine"
              ],
              "example": {
                "term": "Almuerzo con mis compañeros.",
                "translation": "I have lunch with colleagues."
              }
            },
            {
              "id": "es_a2_cenar",
              "term": "Cenar",
              "transliteration": "seh-NAHR",
              "translation": "To have dinner",
              "tags": [
                "A2",
                "routine"
              ],
              "example": {
                "term": "En España se cena tarde.",
                "translation": "In Spain people eat dinner late."
              }
            },
            {
              "id": "es_a2_descansar",
              "term": "Descansar",
              "transliteration": "dehs-kahn-SAHR",
              "translation": "To rest",
              "tags": [
                "A2",
                "routine"
              ],
              "example": {
                "term": "Necesito descansar un rato.",
                "translation": "I need to rest for a while."
              }
            },
            {
              "id": "es_a2_acostarse",
              "term": "Acostarse",
              "transliteration": "ah-kohs-TAHR-seh",
              "translation": "To go to bed",
              "tags": [
                "A2",
                "reflexive"
              ],
              "example": {
                "term": "Me acuesto antes de las once.",
                "translation": "I go to bed before eleven."
              }
            },
            {
              "id": "es_a2_temprano",
              "term": "Temprano",
              "transliteration": "tehm-PRAH-noh",
              "translation": "Early",
              "tags": [
                "A2",
                "time"
              ],
              "example": {
                "term": "Mañana salgo temprano.",
                "translation": "Tomorrow I leave early."
              }
            }
          ]
        },
        {
          "id": "es-a2-u1-l3",
          "title": "Frequency & Habits",
          "objective": "Say how often you practice or do activities.",
          "grammarNote": "Combine adverbs like siempre (always), a menudo (often), and casi nunca (almost never).",
          "items": [
            {
              "id": "es_a2_siempre",
              "term": "Siempre",
              "transliteration": "SYEHM-preh",
              "translation": "Always",
              "tags": [
                "A2",
                "adverb"
              ],
              "example": {
                "term": "Siempre hago una copia de seguridad.",
                "translation": "I always make a backup."
              }
            },
            {
              "id": "es_a2_a_menudo",
              "term": "A menudo",
              "transliteration": "ah meh-NOO-doh",
              "translation": "Often / Frequently",
              "tags": [
                "A2",
                "adverb"
              ],
              "example": {
                "term": "Repaso las tarjetas a menudo.",
                "translation": "I review flashcards often."
              }
            },
            {
              "id": "es_a2_a_veces",
              "term": "A veces",
              "transliteration": "ah BEH-sehs",
              "translation": "Sometimes",
              "tags": [
                "A2",
                "adverb"
              ],
              "example": {
                "term": "A veces escucho pódcast en español.",
                "translation": "Sometimes I listen to Spanish podcasts."
              }
            },
            {
              "id": "es_a2_nunca",
              "term": "Nunca",
              "transliteration": "NOON-kah",
              "translation": "Never",
              "tags": [
                "A2",
                "adverb"
              ],
              "example": {
                "term": "Nunca es tarde para empezar.",
                "translation": "It is never too late to start."
              }
            },
            {
              "id": "es_a2_costumbre",
              "term": "La costumbre",
              "transliteration": "lah kohs-TOOM-breh",
              "translation": "Habit / Custom",
              "tags": [
                "A2",
                "noun"
              ],
              "example": {
                "term": "Tengo la costumbre de leer cada noche.",
                "translation": "I have the habit of reading each night."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-a2-u2",
      "title": "Hobbies & Preferences",
      "subtitle": "Aficiones y gustos · Mastering gustar, encantar & free time",
      "cefrLevel": "A2",
      "color": "#6366f1",
      "lessons": [
        {
          "id": "es-a2-u2-l1",
          "title": "Likes with Gustar & Encantar",
          "objective": "Express what you like, love, or find interesting.",
          "grammarNote": "Use 'me gusta' + singular noun/infinitive, and 'me gustan' + plural nouns.",
          "items": [
            {
              "id": "es_a2_me_gusta",
              "term": "Me gusta",
              "transliteration": "meh GOOS-tah",
              "translation": "I like (singular / verb)",
              "tags": [
                "A2",
                "grammar"
              ],
              "example": {
                "term": "Me gusta aprender idiomas nuevos.",
                "translation": "I like learning new languages."
              }
            },
            {
              "id": "es_a2_me_encanta",
              "term": "Me encanta",
              "transliteration": "meh ehn-KAHN-tah",
              "translation": "I love (something)",
              "tags": [
                "A2",
                "grammar"
              ],
              "example": {
                "term": "Me encanta la comida picante.",
                "translation": "I love spicy food."
              }
            },
            {
              "id": "es_a2_me_interesa",
              "term": "Me interesa",
              "transliteration": "meh een-teh-REH-sah",
              "translation": "It interests me",
              "tags": [
                "A2",
                "grammar"
              ],
              "example": {
                "term": "Me interesa la historia japonesa.",
                "translation": "Japanese history interests me."
              }
            },
            {
              "id": "es_a2_preferir",
              "term": "Preferir",
              "transliteration": "preh-feh-REER",
              "translation": "To prefer",
              "tags": [
                "A2",
                "verb"
              ],
              "example": {
                "term": "Prefiero estudiar por la mañana.",
                "translation": "I prefer studying in the morning."
              }
            },
            {
              "id": "es_a2_tiempo_libre",
              "term": "El tiempo libre",
              "transliteration": "ehl TYEHM-poh LEE-breh",
              "translation": "Free time",
              "tags": [
                "A2",
                "noun"
              ],
              "example": {
                "term": "En mi tiempo libre programo.",
                "translation": "In my free time I code."
              }
            }
          ]
        },
        {
          "id": "es-a2-u2-l2",
          "title": "Sports, Music & Arts",
          "objective": "Chat about weekend activities and hobbies.",
          "grammarNote": "Use 'jugar a' for sports/games and 'tocar' for musical instruments.",
          "items": [
            {
              "id": "es_a2_deporte",
              "term": "El deporte",
              "transliteration": "ehl deh-POHR-teh",
              "translation": "Sport",
              "tags": [
                "A2",
                "hobby"
              ],
              "example": {
                "term": "Hago deporte tres veces por semana.",
                "translation": "I do sports three times a week."
              }
            },
            {
              "id": "es_a2_pelicula",
              "term": "La película",
              "transliteration": "lah peh-LEE-koo-lah",
              "translation": "Movie / Film",
              "tags": [
                "A2",
                "hobby"
              ],
              "example": {
                "term": "Vimos una película con subtítulos.",
                "translation": "We watched a movie with subtitles."
              }
            },
            {
              "id": "es_a2_musica",
              "term": "La música",
              "transliteration": "lah MOO-see-kah",
              "translation": "Music",
              "tags": [
                "A2",
                "hobby"
              ],
              "example": {
                "term": "Escucho música mientras trabajo.",
                "translation": "I listen to music while working."
              }
            },
            {
              "id": "es_a2_viajar",
              "term": "Viajar",
              "transliteration": "byah-HAHR",
              "translation": "To travel",
              "tags": [
                "A2",
                "hobby"
              ],
              "example": {
                "term": "Me encantaría viajar por Sudamérica.",
                "translation": "I would love to travel across South America."
              }
            },
            {
              "id": "es_a2_cocinar",
              "term": "Cocinar",
              "transliteration": "koh-see-NAHR",
              "translation": "To cook",
              "tags": [
                "A2",
                "hobby"
              ],
              "example": {
                "term": "Aprendí a cocinar platos nuevos.",
                "translation": "I learned to cook new dishes."
              }
            }
          ]
        },
        {
          "id": "es-a2-u2-l3",
          "title": "Making Plans Together",
          "objective": "Invite friends and accept or suggest times.",
          "grammarNote": "'¿Quedamos...?' is the go-to colloquial Spanish verb for 'Shall we meet up?'.",
          "items": [
            {
              "id": "es_a2_quedar",
              "term": "Quedar",
              "transliteration": "keh-DAHR",
              "translation": "To meet up / arrange",
              "tags": [
                "A2",
                "social"
              ],
              "example": {
                "term": "¿Quedamos a las seis en la plaza?",
                "translation": "Shall we meet at six in the square?"
              }
            },
            {
              "id": "es_a2_invitar",
              "term": "Invitar",
              "transliteration": "een-bee-TAHR",
              "translation": "To invite / treat",
              "tags": [
                "A2",
                "social"
              ],
              "example": {
                "term": "Hoy te invito a un café.",
                "translation": "Today coffee is on me."
              }
            },
            {
              "id": "es_a2_disponible",
              "term": "Disponible",
              "transliteration": "dees-poh-NEE-bleh",
              "translation": "Available",
              "tags": [
                "A2",
                "adj"
              ],
              "example": {
                "term": "Estoy disponible el sábado.",
                "translation": "I am available on Saturday."
              }
            },
            {
              "id": "es_a2_genial",
              "term": "¡Genial!",
              "transliteration": "heh-NYAHL",
              "translation": "Great! / Awesome!",
              "tags": [
                "A2",
                "social"
              ],
              "example": {
                "term": "¡Genial! Allí nos vemos.",
                "translation": "Great! See you there."
              }
            },
            {
              "id": "es_a2_otra_vez",
              "term": "Otra vez",
              "transliteration": "OH-trah behs",
              "translation": "Again / Another time",
              "tags": [
                "A2",
                "phrase"
              ],
              "example": {
                "term": "Tenemos que repetirlo otra vez.",
                "translation": "We have to do it again another time."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-a2-u3",
      "title": "Travel & Directions",
      "subtitle": "Viajes y direcciones · Getting around Spanish-speaking cities",
      "cefrLevel": "A2",
      "color": "#8b5cf6",
      "lessons": [
        {
          "id": "es-a2-u3-l1",
          "title": "Street Directions",
          "objective": "Follow and give clear walking directions.",
          "grammarNote": "Combine 'sigue todo recto' with 'gira a la derecha/izquierda en la esquina'.",
          "items": [
            {
              "id": "es_a2_todo_recto",
              "term": "Todo recto",
              "transliteration": "TOH-doh REHK-toh",
