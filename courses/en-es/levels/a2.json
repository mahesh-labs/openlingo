              "id": "es_a2_aeropuerto",
              "term": "El aeropuerto",
              "transliteration": "ehl ah-eh-roh-PWEHR-toh",
              "translation": "Airport",
              "tags": [
                "A2",
                "travel"
              ],
              "example": {
                "term": "Llegamos al aeropuerto dos horas antes.",
                "translation": "We arrived at the airport two hours early."
              }
            },
            {
              "id": "es_a2_equipaje",
              "term": "El equipaje",
              "transliteration": "ehl eh-kee-PAH-heh",
              "translation": "Luggage",
              "tags": [
                "A2",
                "travel"
              ],
              "example": {
