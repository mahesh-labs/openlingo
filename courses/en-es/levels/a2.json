              "tags": [
                "A2",
                "direction"
              ],
              "example": {
                "term": "Sigue todo recto dos manzanas.",
                "translation": "Go straight ahead two blocks."
              }
            },
            {
              "id": "es_a2_izquierda",
              "term": "A la izquierda",
              "transliteration": "ah lah ees-KYEHR-dah",
              "translation": "To the left",
              "tags": [
                "A2",
                "direction"
              ],
              "example": {
                "term": "Gira a la izquierda en el semáforo.",
                "translation": "Turn left at the traffic light."
              }
            },
            {
              "id": "es_a2_derecha",
              "term": "A la derecha",
              "transliteration": "ah lah deh-REH-chah",
              "translation": "To the right",
              "tags": [
                "A2",
                "direction"
              ],
              "example": {
                "term": "El museo está a la derecha.",
                "translation": "The museum is on the right."
              }
            },
            {
              "id": "es_a2_esquina",
              "term": "La esquina",
              "transliteration": "lah ehs-KEE-nah",
              "translation": "Corner",
              "tags": [
                "A2",
                "direction"
              ],
              "example": {
                "term": "Hay una panadería en la esquina.",
                "translation": "There is a bakery on the corner."
              }
            },
            {
              "id": "es_a2_cruzar",
              "term": "Cruzar",
              "transliteration": "kroo-SAHR",
              "translation": "To cross",
              "tags": [
                "A2",
                "direction"
              ],
              "example": {
                "term": "Cruza el puente peatonal.",
                "translation": "Cross the pedestrian bridge."
              }
            }
          ]
        },
