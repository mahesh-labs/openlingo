{
  "id": "sec-a1",
  "jlptLevel": "A1",
  "tier": "Beginner",
  "title": "CEFR A1 — Complete Foundations",
  "description": "Greetings, family, numbers, time, food, shopping, daily verbs, places, descriptions, and essential questions.",
  "color": "#10b981",
  "units": [
    {
      "id": "es-a1-u1",
      "title": "First Steps & Greetings",
      "subtitle": "Saludos · Everyday greetings, politeness & farewells",
      "cefrLevel": "A1",
      "color": "#10b981",
      "lessons": [
        {
          "id": "es-a1-u1-l1",
          "title": "Time-of-Day Greetings",
          "objective": "Greet people naturally morning, afternoon, and night.",
          "grammarNote": "Spanish uses inverted ¡ and ¿ at the start of exclamations and questions. The letter 'h' is silent.",
          "items": [
            {
              "id": "es_a1_hola",
              "term": "Hola",
              "transliteration": "OH-lah",
              "translation": "Hello",
              "tags": [
                "A1",
                "greeting"
              ],
              "example": {
                "term": "¡Hola! ¿Cómo estás?",
                "translation": "Hello! How are you?"
              }
            },
            {
              "id": "es_a1_buenos_dias",
              "term": "Buenos días",
              "transliteration": "BWEH-nohs DEE-ahs",
              "translation": "Good morning",
              "tags": [
                "A1",
                "greeting"
              ],
              "example": {
                "term": "Buenos días, profesor.",
                "translation": "Good morning, professor."
              }
            },
            {
              "id": "es_a1_buenas_tardes",
              "term": "Buenas tardes",
              "transliteration": "BWEH-nahs TAR-dehs",
              "translation": "Good afternoon",
              "tags": [
                "A1",
                "greeting"
              ],
              "example": {
                "term": "Buenas tardes a todos.",
                "translation": "Good afternoon, everyone."
              }
            },
            {
              "id": "es_a1_buenas_noches",
              "term": "Buenas noches",
              "transliteration": "BWEH-nahs NOH-chehs",
              "translation": "Good evening / Good night",
              "tags": [
                "A1",
                "greeting"
              ],
              "example": {
                "term": "Buenas noches, que descanses.",
                "translation": "Good night, rest well."
              }
            },
            {
              "id": "es_a1_que_tal",
              "term": "¿Qué tal?",
              "transliteration": "keh tahl",
              "translation": "How's it going?",
              "tags": [
                "A1",
                "greeting"
              ],
              "example": {
                "term": "¡Hola, amigo! ¿Qué tal?",
                "translation": "Hello, friend! How's it going?"
              }
            }
          ]
        },
        {
          "id": "es-a1-u1-l2",
          "title": "Politeness & Gratitude",
          "objective": "Say please, thank you, excuse me, and you're welcome.",
          "grammarNote": "Use 'disculpe' (formal) or 'perdón' to apologize or politely get attention.",
          "items": [
            {
              "id": "es_a1_gracias",
              "term": "Muchas gracias",
              "transliteration": "MOO-chahs GRAH-syahs",
              "translation": "Thank you very much",
              "tags": [
                "A1",
                "polite"
              ],
              "example": {
                "term": "Muchas gracias por tu ayuda.",
                "translation": "Thank you very much for your help."
              }
            },
            {
              "id": "es_a1_de_nada",
              "term": "De nada",
              "transliteration": "deh NAH-dah",
              "translation": "You're welcome",
              "tags": [
                "A1",
                "polite"
              ],
              "example": {
                "term": "—Gracias. —De nada.",
                "translation": "—Thank you. —You're welcome."
              }
            },
            {
              "id": "es_a1_por_favor",
              "term": "Por favor",
              "transliteration": "pohr fah-BOHR",
              "translation": "Please",
              "tags": [
                "A1",
                "polite"
              ],
              "example": {
                "term": "Un té caliente, por favor.",
                "translation": "A hot tea, please."
              }
            },
            {
              "id": "es_a1_perdon",
              "term": "Perdón",
              "transliteration": "pehr-DOHN",
              "translation": "Excuse me / Sorry",
              "tags": [
                "A1",
                "polite"
              ],
              "example": {
                "term": "Perdón, ¿puedo pasar?",
                "translation": "Excuse me, may I pass?"
              }
            },
            {
              "id": "es_a1_lo_siento",
              "term": "Lo siento",
              "transliteration": "loh SYEHN-toh",
              "translation": "I'm sorry",
              "tags": [
                "A1",
                "polite"
              ],
              "example": {
                "term": "Lo siento, llegué tarde.",
                "translation": "I'm sorry, I arrived late."
              }
            }
          ]
        },
        {
          "id": "es-a1-u1-l3",
          "title": "Yes, No & Goodbyes",
          "objective": "Respond clearly and say goodbye warmly.",
          "grammarNote": "Combine 'hasta' (until) with time words: hasta luego (see you later), hasta mañana (see you tomorrow).",
          "items": [
            {
              "id": "es_a1_si",
              "term": "Sí",
              "transliteration": "see",
              "translation": "Yes",
              "tags": [
                "A1",
                "basic"
              ],
              "example": {
                "term": "Sí, claro que sí.",
                "translation": "Yes, of course."
              }
            },
            {
              "id": "es_a1_no",
              "term": "No, gracias",
              "transliteration": "noh GRAH-syahs",
              "translation": "No, thank you",
              "tags": [
                "A1",
                "basic"
              ],
              "example": {
                "term": "No, gracias, estoy bien.",
                "translation": "No thank you, I'm fine."
              }
            },
            {
              "id": "es_a1_adios",
              "term": "Adiós",
              "transliteration": "ah-DYOHS",
              "translation": "Goodbye",
              "tags": [
                "A1",
                "farewell"
              ],
              "example": {
                "term": "Adiós, ¡cuídate mucho!",
                "translation": "Goodbye, take good care!"
              }
            },
            {
              "id": "es_a1_hasta_luego",
              "term": "Hasta luego",
              "transliteration": "AHS-tah LWEH-goh",
              "translation": "See you later",
              "tags": [
                "A1",
                "farewell"
              ],
              "example": {
                "term": "Nos vemos pronto, hasta luego.",
                "translation": "See you soon, see you later."
              }
            },
            {
              "id": "es_a1_hasta_manana",
              "term": "Hasta mañana",
              "transliteration": "AHS-tah mah-NYAH-nah",
              "translation": "See you tomorrow",
              "tags": [
                "A1",
                "farewell"
              ],
              "example": {
                "term": "Buen trabajo hoy, hasta mañana.",
                "translation": "Good work today, see you tomorrow."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-a1-u2",
      "title": "Introductions & Family",
      "subtitle": "Presentaciones y familia · Names, ser vs. estar, and relatives",
      "cefrLevel": "A1",
      "color": "#14b8a6",
      "lessons": [
        {
          "id": "es-a1-u2-l1",
          "title": "Introducing Yourself",
          "objective": "Share your name, origin, and ask how someone feels.",
          "grammarNote": "Use 'ser' (soy) for identity and origin, and 'estar' (estoy) for mood and temporary location.",
          "items": [
            {
              "id": "es_a1_me_llamo",
              "term": "Me llamo",
              "transliteration": "meh YAH-moh",
              "translation": "My name is",
              "tags": [
                "A1",
                "intro"
              ],
              "example": {
                "term": "Hola, me llamo Mahesh.",
                "translation": "Hello, my name is Mahesh."
              }
            },
            {
              "id": "es_a1_mucho_gusto",
              "term": "Mucho gusto",
              "transliteration": "MOO-choh GOOS-toh",
              "translation": "Nice to meet you",
              "tags": [
                "A1",
                "intro"
              ],
              "example": {
                "term": "Encantado, mucho gusto.",
                "translation": "Delighted, nice to meet you."
              }
            },
            {
              "id": "es_a1_soy_de",
              "term": "Soy de",
              "transliteration": "soy deh",
              "translation": "I am from",
              "tags": [
                "A1",
                "ser"
              ],
              "example": {
                "term": "Soy de la India.",
                "translation": "I am from India."
              }
            },
            {
              "id": "es_a1_como_estas",
              "term": "¿Cómo estás?",
              "transliteration": "KOH-moh ehs-TAHS",
              "translation": "How are you?",
              "tags": [
                "A1",
                "estar"
              ],
              "example": {
                "term": "¿Cómo estás hoy?",
                "translation": "How are you today?"
              }
            },
            {
              "id": "es_a1_estoy_bien",
              "term": "Estoy bien",
              "transliteration": "ehs-TOY byehn",
              "translation": "I am well / fine",
              "tags": [
                "A1",
                "estar"
              ],
              "example": {
                "term": "Estoy muy bien, gracias.",
                "translation": "I am very well, thank you."
              }
            }
          ]
        },
        {
          "id": "es-a1-u2-l2",
          "title": "People & Professions",
          "objective": "Talk about students, teachers, and friends.",
          "grammarNote": "In Spanish, omit 'un/una' before unmodified professions: 'Soy estudiante' (not 'Soy un estudiante').",
          "items": [
            {
              "id": "es_a1_estudiante",
              "term": "El/La estudiante",
              "transliteration": "ehs-too-DYAHN-teh",
              "translation": "Student",
              "tags": [
                "A1",
                "people"
              ],
              "example": {
                "term": "Soy estudiante de idiomas.",
                "translation": "I am a language student."
              }
            },
            {
              "id": "es_a1_profesor",
              "term": "El profesor",
              "transliteration": "proh-feh-SOHR",
              "translation": "Teacher / Professor",
              "tags": [
                "A1",
                "people"
              ],
              "example": {
                "term": "El profesor explica con claridad.",
                "translation": "The teacher explains clearly."
              }
            },
            {
              "id": "es_a1_amigo",
              "term": "El amigo / La amiga",
              "transliteration": "ah-MEE-goh",
              "translation": "Friend",
              "tags": [
                "A1",
                "people"
              ],
              "example": {
                "term": "Mi amiga habla tres idiomas.",
                "translation": "My friend speaks three languages."
              }
            },
            {
              "id": "es_a1_medico",
              "term": "El médico",
              "transliteration": "MEH-dee-koh",
              "translation": "Doctor",
              "tags": [
                "A1",
                "people"
              ],
              "example": {
                "term": "Mi hermana es médica.",
                "translation": "My sister is a doctor."
              }
            },
            {
              "id": "es_a1_companero",
              "term": "El compañero",
              "transliteration": "kohm-pah-NYEH-roh",
              "translation": "Colleague / Classmate",
              "tags": [
                "A1",
                "people"
              ],
              "example": {
                "term": "Trabajo con buenos compañeros.",
                "translation": "I work with great colleagues."
              }
            }
          ]
        },
        {
          "id": "es-a1-u2-l3",
          "title": "My Family",
          "objective": "Name close family members and describe relatives.",
          "grammarNote": "Possessives agree in number: mi hermano (my brother), mis hermanos (my siblings).",
          "items": [
            {
              "id": "es_a1_familia",
              "term": "La familia",
              "transliteration": "lah fah-MEE-lyah",
              "translation": "Family",
              "tags": [
                "A1",
                "family"
              ],
              "example": {
                "term": "Mi familia vive en Kerala.",
                "translation": "My family lives in Kerala."
              }
            },
            {
              "id": "es_a1_madre",
              "term": "La madre",
              "transliteration": "lah MAH-dreh",
              "translation": "Mother",
              "tags": [
                "A1",
                "family"
              ],
              "example": {
                "term": "Mi madre cocina delicioso.",
                "translation": "My mother cooks deliciously."
              }
            },
            {
              "id": "es_a1_padre",
              "term": "El padre",
              "transliteration": "ehl PAH-dreh",
              "translation": "Father",
              "tags": [
                "A1",
                "family"
              ],
              "example": {
                "term": "Mi padre lee el periódico.",
                "translation": "My father reads the newspaper."
              }
            },
            {
              "id": "es_a1_hermano",
              "term": "El hermano",
              "transliteration": "ehl ehr-MAH-noh",
              "translation": "Brother",
              "tags": [
                "A1",
                "family"
              ],
              "example": {
                "term": "Tengo un hermano mayor.",
                "translation": "I have an older brother."
              }
            },
            {
              "id": "es_a1_hermana",
              "term": "La hermana",
              "transliteration": "lah ehr-MAH-nah",
              "translation": "Sister",
              "tags": [
                "A1",
                "family"
              ],
              "example": {
                "term": "Mi hermana estudia música.",
                "translation": "My sister studies music."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-a1-u3",
      "title": "Numbers, Time & Calendar",
      "subtitle": "Números y tiempo · Counting, telling time & days of the week",
      "cefrLevel": "A1",
      "color": "#0ea5e9",
      "lessons": [
        {
          "id": "es-a1-u3-l1",
          "title": "Numbers 1 to 10",
          "objective": "Count core digits accurately.",
          "grammarNote": "'Uno' shortens to 'un' before masculine singular nouns: un libro, una casa.",
          "items": [
            {
              "id": "es_a1_uno",
              "term": "Uno",
              "transliteration": "OO-noh",
              "translation": "One (1)",
              "tags": [
                "A1",
                "number"
              ],
              "example": {
                "term": "Solo necesito un minuto.",
                "translation": "I only need one minute."
              }
            },
            {
              "id": "es_a1_dos",
              "term": "Dos",
              "transliteration": "dohs",
              "translation": "Two (2)",
              "tags": [
                "A1",
                "number"
              ],
              "example": {
                "term": "Dos entradas, por favor.",
                "translation": "Two tickets, please."
              }
            },
            {
              "id": "es_a1_tres",
              "term": "Tres",
              "transliteration": "trehs",
              "translation": "Three (3)",
              "tags": [
                "A1",
                "number"
              ],
              "example": {
                "term": "Son las tres de la tarde.",
                "translation": "It is three in the afternoon."
              }
            },
            {
              "id": "es_a1_cinco",
              "term": "Cinco",
              "transliteration": "SEEN-koh",
              "translation": "Five (5)",
              "tags": [
                "A1",
                "number"
              ],
              "example": {
                "term": "Llegamos en cinco minutos.",
                "translation": "We arrive in five minutes."
              }
            },
            {
              "id": "es_a1_diez",
              "term": "Diez",
              "transliteration": "dyehs",
              "translation": "Ten (10)",
              "tags": [
                "A1",
                "number"
              ],
              "example": {
                "term": "Estudio diez minutos diarios.",
                "translation": "I study ten minutes daily."
              }
            }
          ]
        },
        {
          "id": "es-a1-u3-l2",
          "title": "Telling Time",
          "objective": "Ask and state the time of day.",
          "grammarNote": "Use 'Es la una' for 1:00 and 'Son las...' for all other hours.",
          "items": [
            {
              "id": "es_a1_que_hora",
              "term": "¿Qué hora es?",
              "transliteration": "keh OH-rah ehs",
              "translation": "What time is it?",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "Perdón, ¿qué hora es?",
                "translation": "Excuse me, what time is it?"
              }
            },
            {
              "id": "es_a1_media",
              "term": "Y media",
              "transliteration": "ee MEH-dyah",
              "translation": "Half past (:30)",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "La clase empieza a las ocho y media.",
                "translation": "Class starts at 8:30."
              }
            },
            {
              "id": "es_a1_cuarto",
              "term": "Y cuarto",
              "transliteration": "ee KWAHR-toh",
              "translation": "Quarter past (:15)",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "Nos vemos a las cuatro y cuarto.",
                "translation": "See you at 4:15."
              }
            },
            {
              "id": "es_a1_ahora",
              "term": "Ahora",
              "transliteration": "ah-OH-rah",
              "translation": "Now",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "Vamos a empezar ahora mismo.",
                "translation": "Let's start right now."
              }
            },
            {
              "id": "es_a1_pronto",
              "term": "Pronto",
              "transliteration": "PROHN-toh",
              "translation": "Soon",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "Volveremos muy pronto.",
                "translation": "We will return very soon."
              }
            }
          ]
        },
        {
          "id": "es-a1-u3-l3",
          "title": "Days & Calendar",
          "objective": "Refer to yesterday, today, tomorrow, and days of the week.",
          "grammarNote": "Days of the week are lowercase and masculine: el lunes (on Monday), los lunes (on Mondays).",
          "items": [
            {
              "id": "es_a1_hoy",
              "term": "Hoy",
              "transliteration": "oy",
              "translation": "Today",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "Hoy hace sol.",
                "translation": "Today it is sunny."
              }
            },
            {
              "id": "es_a1_manana",
              "term": "Mañana",
              "transliteration": "mah-NYAH-nah",
              "translation": "Tomorrow / Morning",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "Mañana tenemos examen.",
                "translation": "Tomorrow we have an exam."
              }
            },
            {
              "id": "es_a1_lunes",
              "term": "El lunes",
              "transliteration": "ehl LOO-nehs",
              "translation": "Monday",
              "tags": [
                "A1",
                "calendar"
              ],
              "example": {
                "term": "El lunes empiezo el nivel A2.",
                "translation": "On Monday I start level A2."
              }
            },
            {
              "id": "es_a1_fin_semana",
              "term": "El fin de semana",
              "transliteration": "ehl feen deh seh-MAH-nah",
              "translation": "Weekend",
              "tags": [
                "A1",
                "calendar"
              ],
              "example": {
                "term": "Descanso el fin de semana.",
                "translation": "I rest on the weekend."
              }
            },
            {
              "id": "es_a1_cada_dia",
              "term": "Cada día",
              "transliteration": "KAH-dah DEE-ah",
              "translation": "Every day",
              "tags": [
                "A1",
                "time"
              ],
              "example": {
                "term": "Practico vocabulario cada día.",
                "translation": "I practice vocabulary every day."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "es-a1-u4",
      "title": "Food, Cafés & Shopping",
      "subtitle": "Comida y compras · Ordering meals and shopping in Spanish",
      "cefrLevel": "A1",
      "color": "#06b6d4",
      "lessons": [
        {
          "id": "es-a1-u4-l1",
          "title": "Everyday Food & Drinks",
          "objective": "Order staples at a café or market.",
          "grammarNote": "'Agua' is feminine, yet uses 'el' in singular (el agua fría) to avoid the double 'a' sound.",
          "items": [
            {
              "id": "es_a1_agua",
              "term": "El agua",
              "transliteration": "ehl AH-gwah",
              "translation": "Water",
              "tags": [
                "A1",
                "food"
              ],
              "example": {
                "term": "Un vaso de agua, por favor.",
                "translation": "A glass of water, please."
              }
            },
            {
              "id": "es_a1_cafe",
              "term": "El café",
              "transliteration": "ehl kah-FEH",
              "translation": "Coffee",
              "tags": [
                "A1",
                "food"
              ],
              "example": {
                "term": "Tomo café sin azúcar.",
                "translation": "I drink coffee without sugar."
              }
            },
            {
              "id": "es_a1_pan",
              "term": "El pan",
              "transliteration": "ehl pahn",
              "translation": "Bread",
              "tags": [
                "A1",
                "food"
              ],
              "example": {
                "term": "El pan recién horneado huele bien.",
                "translation": "Freshly baked bread smells good."
              }
            },
            {
              "id": "es_a1_fruta",
              "term": "La fruta",
              "transliteration": "lah FROO-tah",
              "translation": "Fruit",
              "tags": [
                "A1",
                "food"
              ],
              "example": {
                "term": "Como fruta fresca por la mañana.",
                "translation": "I eat fresh fruit in the morning."
              }
            },
            {
              "id": "es_a1_arroz",
              "term": "El arroz",
              "transliteration": "ehl ah-ROHS",
              "translation": "Rice",
              "tags": [
                "A1",
                "food"
              ],
              "example": {
                "term": "El arroz con verduras está rico.",
                "translation": "The rice with vegetables is tasty."
              }
            }
          ]
        },
        {
          "id": "es-a1-u4-l2",
          "title": "At the Restaurant",
          "objective": "Order politely and pay the check.",
          "grammarNote": "Use 'Quisiera...' (I would like) or 'Para mí...' (For me...) to order politely.",
          "items": [
            {
              "id": "es_a1_quisiera",
              "term": "Quisiera",
              "transliteration": "kee-SYEH-rah",
              "translation": "I would like (polite)",
              "tags": [
                "A1",
                "food"
              ],
              "example": {
                "term": "Quisiera una mesa junto a la ventana.",
                "translation": "I would like a table by the window."
              }
            },
