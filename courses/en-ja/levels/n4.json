{
  "id": "sec-n4",
  "jlptLevel": "N4",
  "tier": "Elementary",
  "title": "JLPT N4 — Daily Conversations",
  "description": "Te-form requests, travel, health & home routines, past experiences, potential form, reasons & advice.",
  "color": "#3b82f6",
  "units": [
    {
      "id": "n4-u1",
      "title": "Te-Form & Polite Requests",
      "subtitle": "てけい · Connecting verbs, requests, and ongoing states",
      "cefrLevel": "N4",
      "color": "#3b82f6",
      "lessons": [
        {
          "id": "n4-u1-l1",
          "title": "Making Requests (〜てください)",
          "objective": "Ask people politely to wait, teach, or help.",
          "grammarNote": "Verb て-form + ください makes a polite request; 〜ないでください means 'please don't'.",
          "items": [
            {
              "id": "ja_n4_matte",
              "term": "待ってください",
              "reading": "まってください",
              "transliteration": "matte kudasai",
              "translation": "Please wait",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "少し待ってください。",
                "transliteration": "Sukoshi matte kudasai.",
                "translation": "Please wait a little."
              }
            },
            {
              "id": "ja_n4_oshiete",
              "term": "教えてください",
              "reading": "おしえてください",
              "transliteration": "oshiete kudasai",
              "translation": "Please tell / teach me",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "読み方を教えてください。",
                "transliteration": "Yomikata o oshiete kudasai.",
                "translation": "Please tell me how to read it."
              }
            },
            {
              "id": "ja_n4_tetsudau",
              "term": "手伝う",
              "reading": "てつだう",
              "transliteration": "tetsudau",
              "translation": "To help / assist",
              "tags": [
                "N4",
                "verb"
              ],
              "example": {
                "term": "荷物を手伝いましょうか。",
                "transliteration": "Nimotsu o tetsudaimashou ka.",
                "translation": "Shall I help with your luggage?"
              }
            },
            {
              "id": "ja_n4_yukkuri",
              "term": "ゆっくり話してください",
              "reading": "ゆっくりはなしてください",
              "transliteration": "yukkuri hanashite kudasai",
              "translation": "Please speak slowly",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "もう少しゆっくり話してください。",
                "transliteration": "Mou sukoshi yukkuri hanashite kudasai.",
                "translation": "Please speak a bit more slowly."
              }
            },
            {
              "id": "ja_n4_wasurenaide",
              "term": "忘れないでください",
              "reading": "わすれないでください",
              "transliteration": "wasurenaide kudasai",
              "translation": "Please don't forget",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "パスポートを忘れないでください。",
                "transliteration": "Pasupooto o wasurenaide kudasai.",
                "translation": "Please don't forget your passport."
              }
            }
          ]
        },
        {
          "id": "n4-u1-l2",
          "title": "Ongoing Actions (〜ています)",
          "objective": "Express actions in progress and current states.",
          "grammarNote": "〜ています describes both actions happening right now (食べています) and resulting states (住んでいます = live).",
          "items": [
            {
              "id": "ja_n4_sunde",
              "term": "住んでいます",
              "reading": "すんでいます",
              "transliteration": "sunde imasu",
              "translation": "Living / Residing",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "大阪に住んでいます。",
                "transliteration": "Oosaka ni sunde imasu.",
                "translation": "I live in Osaka."
              }
            },
            {
              "id": "ja_n4_hataraite",
              "term": "働いています",
              "reading": "はたらいています",
              "transliteration": "hataraite imasu",
              "translation": "Working",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "IT会社で働いています。",
                "transliteration": "IT-gaisha de hataraite imasu.",
                "translation": "I work at an IT company."
              }
            },
            {
              "id": "ja_n4_shitte",
              "term": "知っています",
              "reading": "しっています",
              "transliteration": "shitte imasu",
              "translation": "To know (state)",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "その映画を知っていますか。",
                "transliteration": "Sono eiga o shitte imasu ka.",
                "translation": "Do you know that movie?"
              }
            },
            {
              "id": "ja_n4_motte",
              "term": "持っています",
              "reading": "もっています",
              "transliteration": "motte imasu",
              "translation": "To hold / own",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "新しい辞書を持っています。",
                "transliteration": "Atarashii jisho o motte imasu.",
                "translation": "I own a new dictionary."
              }
            },
            {
              "id": "ja_n4_matteiru",
              "term": "待っています",
              "reading": "まっています",
              "transliteration": "matte imasu",
              "translation": "Waiting",
              "tags": [
                "N4",
                "te-form"
              ],
              "example": {
                "term": "改札の前で待っています。",
                "transliteration": "Kaisatsu no mae de matte imasu.",
                "translation": "I am waiting in front of the ticket gate."
              }
            }
          ]
        },
        {
          "id": "n4-u1-l3",
          "title": "Permission & Obligation",
          "objective": "Ask 'May I?', state rules, and express 'must'.",
          "grammarNote": "〜てもいいですか (may I?), 〜てはいけません (must not), 〜なければなりません (must).",
          "items": [
            {
              "id": "ja_n4_temoii",
              "term": "〜てもいいですか",
              "reading": "てもいいですか",
              "transliteration": "te mo ii desu ka",
              "translation": "May I ...?",
              "tags": [
                "N4",
                "grammar"
              ],
              "example": {
                "term": "ここで写真を撮ってもいいですか。",
                "transliteration": "Koko de shashin o totte mo ii desu ka.",
                "translation": "May I take a photo here?"
              }
            },
            {
              "id": "ja_n4_tewaike",
              "term": "〜てはいけません",
              "reading": "てはいけません",
              "transliteration": "te wa ikemasen",
              "translation": "Must not / Prohibited",
              "tags": [
                "N4",
                "grammar"
              ],
              "example": {
                "term": "美術館で走ってはいけません。",
                "transliteration": "Bijutsukan de hashitte wa ikemasen.",
                "translation": "You must not run in the museum."
              }
            },
            {
              "id": "ja_n4_nakereba",
              "term": "〜なければなりません",
              "reading": "なければなりません",
              "transliteration": "nakereba narimasen",
              "translation": "Must / Have to",
              "tags": [
                "N4",
                "grammar"
              ],
              "example": {
                "term": "明日までに提出しなければなりません。",
                "transliteration": "Ashita made ni teishutsu shinakereba narimasen.",
                "translation": "I must submit it by tomorrow."
              }
            },
            {
              "id": "ja_n4_kiotsukeru",
              "term": "気をつける",
              "reading": "きをつける",
              "transliteration": "ki o tsukeru",
              "translation": "To be careful",
              "tags": [
                "N4",
                "phrase"
              ],
              "example": {
                "term": "足元に気をつけてください。",
                "transliteration": "Ashimoto ni ki o tsukete kudasai.",
                "translation": "Please watch your step."
              }
            },
            {
              "id": "ja_n4_yakusoku",
              "term": "約束",
              "reading": "やくそく",
              "transliteration": "yakusoku",
              "translation": "Promise / Appointment",
              "tags": [
                "N4",
                "noun"
              ],
              "example": {
                "term": "友達と約束があります。",
                "transliteration": "Tomodachi to yakusoku ga arimasu.",
                "translation": "I have plans with a friend."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "n4-u2",
      "title": "Travel, Transit & Lodging",
      "subtitle": "りょこうとこうつう · Navigating trains, airports & hotels",
      "cefrLevel": "N4",
      "color": "#6366f1",
      "lessons": [
        {
          "id": "n4-u2-l1",
          "title": "Trains & Transfers",
          "objective": "Navigate Japanese stations and train transfers.",
          "grammarNote": "Use に乗る (board), で降りる (get off at), and に乗り換える (transfer to).",
          "items": [
            {
              "id": "ja_n4_norikaeru",
              "term": "乗り換える",
              "reading": "のりかえる",
              "transliteration": "norikaeru",
              "translation": "To transfer (trains/buses)",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "新宿で山手線に乗り換えます。",
                "transliteration": "Shinjuku de Yamanote-sen ni norikaemasu.",
                "translation": "Transfer to the Yamanote Line at Shinjuku."
              }
            },
            {
              "id": "ja_n4_oriru",
              "term": "降りる",
              "reading": "おりる",
              "transliteration": "oriru",
              "translation": "To get off (a vehicle)",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "次の駅で降ります。",
                "transliteration": "Tsugi no eki de orimasu.",
                "translation": "I get off at the next station."
              }
            },
            {
              "id": "ja_n4_kippu",
              "term": "切符",
              "reading": "きっぷ",
              "transliteration": "kippu",
              "translation": "Ticket",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "券売機で切符を買います。",
                "transliteration": "Kenbaiki de kippu o kaimasu.",
                "translation": "Buy a ticket at the machine."
              }
            },
            {
              "id": "ja_n4_kuukou",
              "term": "空港",
              "reading": "くうこう",
              "transliteration": "kuukou",
              "translation": "Airport",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "空港まで一時間かかります。",
                "transliteration": "Kuukou made ichi-jikan kakarimasu.",
                "translation": "It takes one hour to the airport."
              }
            },
            {
              "id": "ja_n4_nimotsu",
              "term": "荷物",
              "reading": "にもつ",
              "transliteration": "nimotsu",
              "translation": "Luggage / Baggage",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "荷物をコインロッカーに預けました。",
                "transliteration": "Nimotsu o koinrokkaa ni azukemashita.",
                "translation": "I stored my luggage in a coin locker."
              }
            }
          ]
        },
        {
          "id": "n4-u2-l2",
          "title": "Directions Around Town",
          "objective": "Follow street directions and landmarks.",
          "grammarNote": "Pair straight (まっすぐ), corner (角), and crosswalk (横断歩道) with て-form sequences.",
          "items": [
            {
              "id": "ja_n4_massugu",
              "term": "まっすぐ",
              "reading": "まっすぐ",
              "transliteration": "massugu",
              "translation": "Straight ahead",
              "tags": [
                "N4",
                "direction"
              ],
              "example": {
                "term": "この道をまっすぐ行ってください。",
                "transliteration": "Kono michi o massugu itte kudasai.",
                "translation": "Go straight down this road."
              }
            },
            {
              "id": "ja_n4_magaru",
              "term": "曲がる",
              "reading": "まがる",
              "transliteration": "magaru",
              "translation": "To turn",
              "tags": [
                "N4",
                "direction"
              ],
              "example": {
                "term": "次の角を左に曲がります。",
                "transliteration": "Tsugi no kado o hidari ni magarimasu.",
                "translation": "Turn left at the next corner."
              }
            },
            {
              "id": "ja_n4_wataru",
              "term": "渡る",
              "reading": "わたる",
              "transliteration": "wataru",
              "translation": "To cross (bridge/road)",
              "tags": [
                "N4",
                "direction"
              ],
              "example": {
                "term": "橋を渡ると駅が見えます。",
                "transliteration": "Hashi o wataru to eki ga miemasu.",
                "translation": "Cross the bridge and you'll see the station."
              }
            },
            {
              "id": "ja_n4_chizu",
              "term": "地図",
              "reading": "ちず",
              "transliteration": "chizu",
              "translation": "Map",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "スマホで地図を確認します。",
                "transliteration": "Sumaho de chizu o kakunin shimasu.",
                "translation": "I check the map on my phone."
              }
            },
            {
              "id": "ja_n4_chikaku",
              "term": "近く",
              "reading": "ちかく",
              "transliteration": "chikaku",
              "translation": "Nearby / Vicinity",
              "tags": [
                "N4",
                "direction"
              ],
              "example": {
                "term": "ホテルの近くにコンビニがあります。",
                "transliteration": "Hoteru no chikaku ni konbini ga arimasu.",
                "translation": "There is a convenience store near the hotel."
              }
            }
          ]
        },
        {
          "id": "n4-u2-l3",
          "title": "Hotels & Reservations",
          "objective": "Book rooms and manage travel schedules.",
          "grammarNote": "Use 予約する (to reserve) and 泊まる (to stay overnight).",
          "items": [
            {
              "id": "ja_n4_yoyaku",
              "term": "予約",
              "reading": "よやく",
              "transliteration": "yoyaku",
              "translation": "Reservation",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "二泊でホテルを予約しました。",
                "transliteration": "Nihaku de hoteru o yoyaku shimashita.",
                "translation": "I reserved a hotel for two nights."
              }
            },
            {
              "id": "ja_n4_tomaru",
              "term": "泊まる",
              "reading": "とまる",
              "transliteration": "tomaru",
              "translation": "To stay overnight",
              "tags": [
                "N4",
                "travel"
              ],
              "example": {
                "term": "京都の旅館に泊まります。",
                "transliteration": "Kyouto no ryokan ni tomarimasu.",
                "translation": "I will stay at a ryokan in Kyoto."
              }
            },
            {
              "id": "ja_n4_maniau",
              "term": "間に合う",
              "reading": "まにあう",
              "transliteration": "maniau",
              "translation": "To be on time",
              "tags": [
                "N4",
                "verb"
              ],
              "example": {
                "term": "最終電車に間に合いました。",
                "transliteration": "Saishuu densha ni maniaimashita.",
                "translation": "I made it in time for the last train."
              }
            },
            {
              "id": "ja_n4_okureru",
              "term": "遅れる",
              "reading": "おくれる",
              "transliteration": "okureru",
              "translation": "To be late / delayed",
              "tags": [
                "N4",
                "verb"
              ],
              "example": {
                "term": "雪で電車が遅れています。",
                "transliteration": "Yuki de densha ga okurete imasu.",
                "translation": "Trains are delayed due to snow."
              }
            },
            {
              "id": "ja_n4_annai",
              "term": "案内",
              "reading": "あんない",
              "transliteration": "annai",
              "translation": "Guidance / Tour",
              "tags": [
                "N4",
                "noun"
              ],
              "example": {
                "term": "町を案内してくれました。",
                "transliteration": "Machi o annai shite kuremashita.",
                "translation": "They showed me around town."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "n4-u3",
      "title": "Home, Health & Routines",
      "subtitle": "せいかつとけんこう · Everyday living, health, and habits",
      "cefrLevel": "N4",
      "color": "#8b5cf6",
      "lessons": [
        {
          "id": "n4-u3-l1",
          "title": "Around the House",
          "objective": "Talk about rooms, chores, and daily household tasks.",
          "grammarNote": "Use 〜ておく to express doing something in advance (片付けておく = tidy up ahead of time).",
          "items": [
            {
              "id": "ja_n4_heya",
              "term": "部屋",
              "reading": "へや",
              "transliteration": "heya",
              "translation": "Room",
              "tags": [
                "N4",
                "home"
              ],
              "example": {
                "term": "部屋をきれいに掃除します。",
                "transliteration": "Heya o kirei ni souji shimasu.",
                "translation": "I clean the room neatly."
              }
            },
            {
              "id": "ja_n4_souji",
              "term": "掃除",
              "reading": "そうじ",
              "transliteration": "souji",
              "translation": "Cleaning",
              "tags": [
                "N4",
                "home"
              ],
              "example": {
                "term": "週末に部屋の掃除をします。",
                "transliteration": "Shuumatsu ni heya no souji o shimasu.",
                "translation": "I clean my room on weekends."
              }
            },
            {
              "id": "ja_n4_sentaku",
              "term": "洗濯",
              "reading": "せんたく",
              "transliteration": "sentaku",
              "translation": "Laundry",
              "tags": [
                "N4",
                "home"
              ],
              "example": {
                "term": "晴れたので洗濯しました。",
                "transliteration": "Hareta node sentaku shimashita.",
                "translation": "Since it was sunny, I did laundry."
              }
            },
            {
              "id": "ja_n4_ryouri",
              "term": "料理",
              "reading": "りょうり",
              "transliteration": "ryouri",
              "translation": "Cooking / Dish",
              "tags": [
                "N4",
                "home"
              ],
              "example": {
                "term": "家でよく料理を作ります。",
                "transliteration": "Ie de yoku ryouri o tsukurimasu.",
                "translation": "I often cook at home."
              }
            },
            {
              "id": "ja_n4_kagi",
              "term": "鍵",
              "reading": "かぎ",
              "transliteration": "kagi",
              "translation": "Key",
              "tags": [
                "N4",
                "home"
              ],
              "example": {
                "term": "出かける前に鍵を閉めます。",
                "transliteration": "Dekakeru mae ni kagi o shimemasu.",
                "translation": "I lock the door before going out."
              }
            }
          ]
        },
        {
          "id": "n4-u3-l2",
          "title": "Health & Doctor Visits",
          "objective": "Describe basic symptoms and recovery.",
          "grammarNote": "Express pain with [Body Part] が痛いです (頭が痛いです = I have a headache).",
          "items": [
            {
              "id": "ja_n4_byouin",
              "term": "病院",
              "reading": "びょういん",
              "transliteration": "byouin",
              "translation": "Hospital / Clinic",
              "tags": [
                "N4",
                "health"
              ],
              "example": {
                "term": "熱があるので病院へ行きます。",
                "transliteration": "Netsu ga aru node byouin e ikimasu.",
                "translation": "I have a fever, so I'm going to the clinic."
              }
            },
            {
              "id": "ja_n4_kusuri",
              "term": "薬",
              "reading": "くすり",
              "transliteration": "kusuri",
              "translation": "Medicine",
              "tags": [
                "N4",
                "health"
              ],
              "example": {
                "term": "食後に薬を飲みます。",
                "transliteration": "Shokugo ni kusuri o nomimasu.",
                "translation": "I take medicine after meals."
              }
            },
            {
              "id": "ja_n4_itai",
              "term": "痛い",
              "reading": "いたい",
              "transliteration": "itai",
              "translation": "Painful / Hurts",
              "tags": [
                "N4",
                "health"
              ],
              "example": {
                "term": "喉が少し痛いです。",
                "transliteration": "Nodo ga sukoshi itai desu.",
                "translation": "My throat hurts a little."
              }
            },
            {
              "id": "ja_n4_kaze",
              "term": "風邪",
              "reading": "かぜ",
              "transliteration": "kaze",
              "translation": "A cold",
              "tags": [
                "N4",
                "health"
              ],
              "example": {
                "term": "風邪を引いてしまいました。",
                "transliteration": "Kaze o hiite shimaimashita.",
                "translation": "I caught a cold."
              }
            },
            {
              "id": "ja_n4_yasumu",
              "term": "休む",
              "reading": "やすむ",
              "transliteration": "yasumu",
              "translation": "To rest / take time off",
              "tags": [
                "N4",
                "health"
              ],
              "example": {
                "term": "今日はゆっくり休みます。",
                "transliteration": "Kyou wa yukkuri yasumimasu.",
                "translation": "I will rest well today."
              }
            }
          ]
        },
        {
          "id": "n4-u3-l3",
          "title": "Habits & Schedules",
          "objective": "Describe preparations and daily plans.",
          "grammarNote": "Combine 〜前に (before doing) and 〜後で (after doing) to sequence your day.",
          "items": [
            {
              "id": "ja_n4_yotei",
              "term": "予定",
              "reading": "よてい",
              "transliteration": "yotei",
              "translation": "Schedule / Plan",
              "tags": [
                "N4",
                "noun"
              ],
              "example": {
