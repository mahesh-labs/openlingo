  "units": [
    {
      "id": "ml-s3-u1",
      "title": "Feelings, Likes & Abilities",
      "subtitle": "ഇഷ്ടങ്ങളും കഴിവുകളും · Expressing emotions and what you can do",
      "cefrLevel": "S3",
      "color": "#f59e0b",
      "lessons": [
        {
          "id": "ml-s3-u1-l1",
          "title": "Dative Constructions (എനിക്ക്...)",
          "objective": "Express liking, knowing, and ability naturally.",
          "grammarNote": "Malayalam uses dative 'എനിക്ക്' (to me) with ഇഷ്ടമാണ് (like), അറിയാം (know), and കഴിയും (can).",
          "items": [
            {
              "id": "ml_s3_ishtamaanu",
              "term": "ഇഷ്ടമാണ്",
              "transliteration": "Ishtamaanu",
              "translation": "Like / Love",
              "tags": [
                "S3",
                "feeling"
              ],
              "example": {
                "term": "എനിക്ക് പുതിയ ഭാഷകൾ പഠിക്കാൻ ഇഷ്ടമാണ്.",
                "translation": "I like learning new languages."
              }
            },
            {
              "id": "ml_s3_ariyaam",
              "term": "അറിയാം",
              "transliteration": "Ariyaam",
              "translation": "Know",
              "tags": [
                "S3",
                "verb"
              ],
              "example": {
                "term": "എനിക്ക് കുറച്ച് സ്പാനിഷ് അറിയാം.",
                "translation": "I know a little Spanish."
              }
            },
            {
              "id": "ml_s3_kazhiyum",
              "term": "കഴിയും",
              "transliteration": "Kazhiyum",
              "translation": "Can / Be able to",
              "tags": [
                "S3",
                "modal"
              ],
              "example": {
                "term": "ഇന്റർനെറ്റ് ഇല്ലാതെയും പഠിക്കാൻ കഴിയും.",
                "translation": "Can study even without internet."
              }
            },
            {
              "id": "ml_s3_manassilaayi",
              "term": "മനസ്സിലായി",
              "transliteration": "Manassilaayi",
              "translation": "Understood",
              "tags": [
                "S3",
                "phrase"
              ],
              "example": {
                "term": "ഇപ്പോൾ വ്യാകരണം വ്യക്തമായി മനസ്സിലായി.",
                "translation": "Now I clearly understood the grammar."
              }
            },
            {
              "id": "ml_s3_santhosham",
              "term": "സന്തോഷം",
              "transliteration": "Santhosham",
              "translation": "Happiness / Glad",
              "tags": [
                "S3",
                "feeling"
              ],
              "example": {
                "term": "നിങ്ങളുടെ പുരോഗതി കാണുമ്പോൾ സന്തോഷം.",
                "translation": "Glad to see your progress."
              }
            }
          ]
        },
        {
          "id": "ml-s3-u1-l2",
          "title": "Opinions & Feedback",
          "objective": "Ask for opinions and discuss ideas thoughtfully.",
          "grammarNote": "Use 'എന്റെ അഭിപ്രായത്തിൽ' (In my opinion) to introduce viewpoints politely.",
          "items": [
            {
              "id": "ml_s3_abhiprayam",
              "term": "അഭിപ്രായം",
              "transliteration": "Abhipraayam",
              "translation": "Opinion / Feedback",
              "tags": [
                "S3",
                "opinion"
              ],
              "example": {
                "term": "ഈ പുതിയ ഡിസൈനിനെപ്പറ്റി അഭിപ്രായം എന്താണ്?",
                "translation": "What is your opinion on this new design?"
              }
            },
            {
              "id": "ml_s3_aashayam",
              "term": "ആശയം",
              "transliteration": "Aashayam",
              "translation": "Idea / Concept",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "ഇതൊരു മികച്ച ആശയമാണ്.",
                "translation": "This is a great idea."
              }
            },
            {
              "id": "ml_s3_sahaayam",
              "term": "സഹായം",
              "transliteration": "Sahaayam",
              "translation": "Help / Support",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "എന്ത് സഹായമാണ് വേണ്ടത്?",
                "translation": "What help is needed?"
              }
            },
            {
              "id": "ml_s3_samshayam",
              "term": "സംശയം",
              "transliteration": "Samshayam",
              "translation": "Doubt / Question",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "ഉച്ചാരണത്തിൽ സംശയമുണ്ടെങ്കിൽ ഓഡിയോ കേൾക്കാം.",
                "translation": "If in doubt about pronunciation, listen to audio."
              }
            },
            {
              "id": "ml_s3_urappu",
              "term": "ഉറപ്പ്",
              "transliteration": "Urappu",
              "translation": "Certainty / Assurance",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "നിങ്ങൾക്ക് വിജയിക്കാൻ കഴിയുമെന്ന് ഉറപ്പാണ്.",
                "translation": "I'm certain you can succeed."
              }
            }
          ]
        },
        {
          "id": "ml-s3-u1-l3",
          "title": "Surprise, Hope & Effort",
          "objective": "Express deeper personal reactions and goals.",
          "grammarNote": "Combine nouns like ശ്രമം (effort) and പ്രതീക്ഷ (hope) with ചെയ്യുന്നു / ഉണ്ട്.",
          "items": [
            {
              "id": "ml_s3_athbhutham",
              "term": "അത്ഭുതം",
              "transliteration": "Athbhutham",
              "translation": "Surprise / Wonder",
              "tags": [
                "S3",
                "feeling"
              ],
              "example": {
                "term": "ആപ്പിന്റെ വലുപ്പം കണ്ടപ്പോൾ അത്ഭുതം തോന്നി.",
                "translation": "Felt surprised seeing the app's tiny size."
              }
            },
            {
              "id": "ml_s3_pratheeksha",
              "term": "പ്രതീക്ഷ",
              "transliteration": "Pratheeksha",
              "translation": "Hope / Expectation",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "നല്ലൊരു ഭാവിയെക്കുറിച്ച് പ്രതീക്ഷയുണ്ട്.",
                "translation": "There is hope for a bright future."
              }
            },
            {
              "id": "ml_s3_shramam",
              "term": "ശ്രമം",
              "transliteration": "Shramam",
              "translation": "Effort / Attempt",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "നിരന്തരമായ ശ്രമം വിജയം നൽകും.",
                "translation": "Continuous effort brings success."
              }
            },
            {
              "id": "ml_s3_vijayam",
              "term": "വിജയം",
              "transliteration": "Vijayam",
              "translation": "Success / Victory",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "എല്ലാവർക്കും വിജയം ആശംസിക്കുന്നു.",
                "translation": "Wishing success to everyone."
              }
            },
            {
              "id": "ml_s3_buddhimuttu",
              "term": "ബുദ്ധിമുട്ട്",
              "transliteration": "Buddhimuttu",
              "translation": "Difficulty / Trouble",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "തുടക്കത്തിൽ ചെറിയ ബുദ്ധിമുട്ട് ഉണ്ടാകാം.",
                "translation": "There may be slight difficulty at first."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ml-s3-u2",
      "title": "Past & Future Storytelling",
      "subtitle": "കഥപറച്ചിൽ · Narrating events, memories & plans",
      "cefrLevel": "S3",
      "color": "#f97316",
      "lessons": [
        {
          "id": "ml-s3-u2-l1",
          "title": "Past Experiences",
          "objective": "Share what happened using past verbs and memories.",
          "grammarNote": "Malayalam past tense ends in -ഇ (പോയി = went, വാങ്ങി = bought) or -ഉ (കഴിച്ചു = ate, പഠിച്ചു = studied).",
          "items": [
