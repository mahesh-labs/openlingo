                "connector"
              ],
              "example": {
                "term": "എന്നാൽ ശ്രദ്ധിക്കേണ്ട ചില കാര്യങ്ങളുണ്ട്.",
                "translation": "However, there are a few things to watch."
              }
            },
            {
              "id": "ml_s3_appol",
              "term": "അപ്പോൾ",
              "transliteration": "Appol",
              "translation": "Then / At that time",
              "tags": [
                "S3",
                "connector"
              ],
              "example": {
                "term": "അപ്പോൾ നമുക്ക് മലയാളം കൂടി ചേർക്കാം.",
                "translation": "Then let's add Malayalam too."
              }
            },
            {
              "id": "ml_s3_kaaranam",
              "term": "കാരണം",
              "transliteration": "Kaaranam",
              "translation": "Because / Reason",
              "tags": [
                "S3",
                "connector"
              ],
              "example": {
                "term": "കാരണം സെർവർ ഇല്ലാതെ പ്രവർത്തിക്കണം.",
                "translation": "Because it must work without a server."
              }
            }
          ]
        }
      ]
    },
