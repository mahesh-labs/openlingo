              }
            },
            {
              "id": "ml_s3_paddhathi",
              "term": "പദ്ധതി",
              "transliteration": "Paddhathi",
              "translation": "Plan / Scheme",
              "tags": [
                "S3",
                "noun"
              ],
              "example": {
                "term": "പുതിയ പഠന പദ്ധതി തയ്യാറാക്കി.",
