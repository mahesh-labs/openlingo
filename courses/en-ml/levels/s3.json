              }
            },
            {
              "id": "ml_s3_thudangum",
              "term": "തുടങ്ങും",
              "transliteration": "Thudangum",
              "translation": "Will start",
              "tags": [
                "S3",
                "future"
              ],
              "example": {
                "term": "നാളെ അടുത്ത യൂണിറ്റ് തുടങ്ങും.",
