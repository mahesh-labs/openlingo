              }
            },
            {
              "id": "ml_s3_theerkkum",
              "term": "തീർക്കും",
              "transliteration": "Theerkkum",
              "translation": "Will finish",
              "tags": [
                "S3",
                "future"
              ],
              "example": {
                "term": "ഈ ആഴ്ചയ്ക്കുള്ളിൽ പാഠങ്ങൾ തീർക്കും.",
                "translation": "Will finish the lessons within this week."
              }
            },
            {
              "id": "ml_s3_adutha",
              "term": "അടുത്ത",
              "transliteration": "Adutha",
              "translation": "Next",
              "tags": [
                "S3",
                "time"
              ],
              "example": {
                "term": "അടുത്ത ഘട്ടത്തിലേക്ക് കടക്കാം.",
                "translation": "Let's move to the next stage."
              }
            }
          ]
        },
        {
          "id": "ml-s3-u2-l3",
          "title": "Natural Connectors",
          "objective": "Link longer spoken sentences smoothly.",
          "grammarNote": "Master പക്ഷേ (but), അതുകൊണ്ട് (therefore), എന്നാൽ (however), and അപ്പോൾ (then).",
          "items": [
