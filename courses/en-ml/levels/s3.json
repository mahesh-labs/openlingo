                "connector"
              ],
              "example": {
                "term": "ഇത് സൗജന്യമാണ്, അതുകൊണ്ട് എല്ലാവർക്കും പഠിക്കാം.",
                "translation": "It's free, so everyone can learn."
              }
            },
            {
              "id": "ml_s3_ennaal",
              "term": "എന്നാൽ",
