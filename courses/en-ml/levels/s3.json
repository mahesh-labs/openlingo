              "term": "പോയി",
              "transliteration": "Poyi",
              "translation": "Went",
              "tags": [
                "S3",
                "past"
              ],
              "example": {
                "term": "കഴിഞ്ഞ മാസം ഞാൻ മൂന്നാറിൽ പോയി.",
                "translation": "Last month I went to Munnar."
              }
            },
            {
              "id": "ml_s3_padichu",
              "term": "പഠിച്ചു",
