                "translation": "This is a major new step forward."
              }
            },
            {
              "id": "ml_s5_manassu_vekkuka",
              "term": "മനസ്സുവെയ്ക്കുക",
              "transliteration": "Manassuvekkuka",
              "translation": "To set one's mind to",
              "tags": [
                "S5",
                "idiom"
