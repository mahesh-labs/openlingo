        {
          "id": "ml-s5-u1-l1",
          "title": "Proverbs of Perseverance",
          "objective": "Learn beloved sayings on steady growth and unity.",
          "grammarNote": "Malayalam proverbs (പഴഞ്ചൊല്ലുകൾ) are concise, melodic, and rooted in Kerala's nature and daily life.",
          "items": [
            {
              "id": "ml_s5_pala_thulli",
              "term": "പല തുള്ളി പെരുവെള്ളം",
              "transliteration": "Pala thulli peruvellam",
              "translation": "Many drops make a mighty flood",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "ദിവസവും അഞ്ച് വാക്ക് മതി—പല തുള്ളി പെരുവെള്ളം.",
                "translation": "Five words a day suffice—many drops make a flood."
              }
            },
            {
              "id": "ml_s5_melle_thinnal",
              "term": "മെല്ലെ തിന്നാൽ പനയും തിന്നാം",
              "transliteration": "Melle thinnaal panayum thinnaam",
              "translation": "Slow and steady conquers huge tasks",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "ധൃതി വേണ്ട, മെല്ലെ തിന്നാൽ പനയും തിന്നാം.",
                "translation": "No rush; slow and steady achieves great things."
              }
            },
            {
              "id": "ml_s5_otthorumichaal",
              "term": "ഒത്തൊരുമിച്ചാൽ മലയും നീക്കാം",
              "transliteration": "Otthorumichaal malayum neekkaam",
              "translation": "United together, even a mountain moves",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "കമ്മ്യൂണിറ്റി ഒത്തൊരുമിച്ചാൽ മലയും നീക്കാം.",
                "translation": "When a community unites, mountains move."
              }
            },
            {
              "id": "ml_s5_vidya_dhanam",
              "term": "വിദ്യാധനം സർവ്വധനാൽ പ്രധാനം",
              "transliteration": "Vidyaadhanam sarvvadhanaal pradhaanam",
              "translation": "Knowledge is the greatest of all wealth",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "വിദ്യാധനം സർവ്വധനാൽ പ്രധാനം എന്ന് പഴമക്കാർ പറയുന്നു.",
                "translation": "Elders say knowledge is the greatest wealth."
              }
            },
            {
              "id": "ml_s5_ariyathathu",
              "term": "അറിയാത്ത പിള്ള ചൊറിയുമ്പോൾ അറിയും",
              "transliteration": "Ariyaatha pilla choriyumpol ariyum",
              "translation": "Experience is the best teacher",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "സ്വയം ചെയ്ത് നോക്കൂ—അനുഭവമാണ് വലിയ ഗുരു.",
                "translation": "Try it yourself—experience is the greatest teacher."
              }
            }
          ]
        },
        {
          "id": "ml-s5-u1-l2",
          "title": "Proverbs of Wisdom & Foresight",
          "objective": "Understand traditional sayings on preparation and insight.",
          "grammarNote": "Many proverbs pair vivid rural metaphors with practical life advice.",
          "items": [
            {
              "id": "ml_s5_venamengil",
              "term": "വേണമെങ്കിൽ ചക്ക വേരിലും കായ്ക്കും",
              "transliteration": "Venamengil chakka verilum kaaykkum",
              "translation": "Where there's a will, there's a way",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "മനസ്സുണ്ടെങ്കിൽ ഏത് ഭാഷയും പഠിക്കാം—വേണമെങ്കിൽ ചക്ക വേരിലും കായ്ക്കും.",
                "translation": "With willpower, any language is possible."
              }
            },
            {
              "id": "ml_s5_minnunnathu",
              "term": "മിന്നുന്നതെല്ലാം പൊന്നല്ല",
              "transliteration": "Minnunnathellaam ponnalla",
              "translation": "All that glitters is not gold",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "വലിയ ആപ്പ് ആയതുകൊണ്ട് മികച്ചതാകണമെന്നില്ല—മിന്നുന്നതെല്ലാം പൊന്നല്ല.",
                "translation": "Bigger isn't always better—all that glitters isn't gold."
              }
            },
            {
              "id": "ml_s5_mulline",
              "term": "മുള്ളിനെ മുള്ളുകൊണ്ടെടുക്കണം",
              "transliteration": "Mulline mullukondedukkanam",
              "translation": "Fight fire with fire / Match the tool to the task",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "കൃത്യമായ തന്ത്രം ഉപയോഗിക്കണം.",
                "translation": "Use the exact right strategy."
              }
            },
            {
              "id": "ml_s5_kunnolam",
              "term": "കുന്നോളം ആഗ്രഹിച്ചാലേ കുന്നിക്കുരുവോളം കിട്ടൂ",
              "transliteration": "Kunnolam aagrahichaale kunnikkuruvolam kittoo",
              "translation": "Aim for the stars to reach the treetops",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "വലിയ ലക്ഷ്യങ്ങൾ വെയ്ക്കൂ.",
                "translation": "Set ambitious goals."
              }
            },
            {
              "id": "ml_s5_aalam",
              "term": "ആഴമുള്ള വെള്ളത്തിന് ഒഴുക്ക് കുറവ്",
              "transliteration": "Aazhamulla vellathinu ozhukku kuravu",
              "translation": "Still waters run deep",
              "tags": [
                "S5",
                "proverb"
              ],
              "example": {
                "term": "യഥാർത്ഥ അറിവുള്ളവർ വിനയമുള്ളവരായിരിക്കും.",
                "translation": "Truly knowledgeable people are humble."
              }
            }
          ]
        },
        {
