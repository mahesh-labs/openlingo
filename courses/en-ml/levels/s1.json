{
  "id": "sec-ml-1",
  "jlptLevel": "S1",
  "tier": "Beginner",
  "title": "Stage 1 — Foundations & Survival",
  "description": "Greetings, family, numbers, time, ordering chaya & meals, and essential questions in Kerala.",
  "color": "#10b981",
  "units": [
    {
      "id": "ml-s1-u1",
      "title": "Greetings & Politeness",
      "subtitle": "അഭിവാദ്യങ്ങൾ · Warm welcomes, gratitude & basic replies",
      "cefrLevel": "S1",
      "color": "#10b981",
      "lessons": [
        {
          "id": "ml-s1-u1-l1",
          "title": "Essential Greetings",
          "objective": "Greet people warmly and ask how they are.",
          "grammarNote": "നമസ്കാരം works any time of day. Adding 'ആണോ?' (aano?) forms friendly yes/no questions.",
          "items": [
            {
              "id": "ml_s1_namaskaram",
              "term": "നമസ്കാരം",
              "transliteration": "Namaskaram",
              "translation": "Hello / Greetings",
              "tags": [
                "S1",
                "greeting"
              ],
              "example": {
                "term": "നമസ്കാരം, സുഖമാണോ?",
                "translation": "Hello, are you well?"
              }
            },
            {
              "id": "ml_s1_sukhamano",
              "term": "സുഖമാണോ?",
              "transliteration": "Sukhamaano?",
              "translation": "How are you?",
              "tags": [
                "S1",
                "greeting"
              ],
              "example": {
                "term": "വീട്ടിൽ എല്ലാവർക്കും സുഖമാണോ?",
                "translation": "Is everyone well at home?"
              }
            },
            {
              "id": "ml_s1_sukhamaanu",
              "term": "സുഖമാണ്",
              "transliteration": "Sukhamaanu",
              "translation": "I am fine / well",
              "tags": [
                "S1",
                "greeting"
              ],
              "example": {
                "term": "എനിക്ക് സുഖമാണ്, നന്ദി.",
                "translation": "I am fine, thank you."
              }
            },
            {
              "id": "ml_s1_suprabhatham",
              "term": "സുപ്രഭാതം",
              "transliteration": "Suprabhaatham",
              "translation": "Good morning",
              "tags": [
                "S1",
                "greeting"
              ],
              "example": {
                "term": "സുപ്രഭാതം, നല്ലൊരു ദിവസം ആശംസിക്കുന്നു.",
                "translation": "Good morning, wishing you a good day."
              }
            },
            {
              "id": "ml_s1_shubharathri",
              "term": "ശുഭരാത്രി",
              "transliteration": "Shubharaathri",
              "translation": "Good night",
              "tags": [
                "S1",
                "greeting"
              ],
              "example": {
                "term": "ശുഭരാത്രി, നാളെ കാണാം.",
                "translation": "Good night, see you tomorrow."
              }
            }
          ]
        },
        {
          "id": "ml-s1-u1-l2",
          "title": "Gratitude & Courtesy",
          "objective": "Thank others, apologize, and respond politely.",
          "grammarNote": "Notice the difference between അല്ല (alla = is not) and ഇല്ല (illa = does not exist / do not have).",
          "items": [
            {
              "id": "ml_s1_nanni",
              "term": "നന്ദി",
              "transliteration": "Nanni",
              "translation": "Thank you",
              "tags": [
                "S1",
                "polite"
              ],
              "example": {
                "term": "വളരെ നന്ദി.",
                "translation": "Thank you very much."
              }
            },
            {
              "id": "ml_s1_kshamikkanam",
              "term": "ക്ഷമിക്കണം",
              "transliteration": "Kshamikkanam",
              "translation": "Excuse me / Sorry",
              "tags": [
                "S1",
                "polite"
              ],
              "example": {
                "term": "ക്ഷമിക്കണം, എനിക്ക് മനസ്സിലായില്ല.",
                "translation": "Sorry, I didn't understand."
              }
            },
            {
              "id": "ml_s1_athe",
              "term": "അതെ",
              "transliteration": "Athe",
              "translation": "Yes",
              "tags": [
                "S1",
                "basic"
              ],
              "example": {
                "term": "അതെ, അത് ശരിയാണ്.",
                "translation": "Yes, that is right."
              }
            },
            {
              "id": "ml_s1_alla",
              "term": "അല്ല / ഇല്ല",
              "transliteration": "Alla / Illa",
              "translation": "No (not / don't have)",
              "tags": [
                "S1",
                "basic"
              ],
              "example": {
                "term": "ഇല്ല, പ്രശ്നമില്ല.",
                "translation": "No, no problem."
              }
            },
            {
              "id": "ml_s1_shari",
              "term": "ശരി",
              "transliteration": "Shari",
              "translation": "Okay / Right",
              "tags": [
                "S1",
                "basic"
              ],
              "example": {
                "term": "ശരി, നമുക്ക് തുടങ്ങാം.",
                "translation": "Okay, let's begin."
              }
            }
          ]
        },
        {
          "id": "ml-s1-u1-l3",
          "title": "Farewells & Warmth",
          "objective": "Say goodbye and welcome guests gracefully.",
          "grammarNote": "Malayalam farewells often imply returning soon: 'പിന്നെ കാണാം' (see you later).",
          "items": [
            {
              "id": "ml_s1_pinne_kanam",
              "term": "പിന്നെ കാണാം",
              "transliteration": "Pinne kaanaam",
              "translation": "See you later",
              "tags": [
                "S1",
                "farewell"
              ],
              "example": {
                "term": "ശരി, പിന്നെ കാണാം.",
                "translation": "Okay, see you later."
              }
            },
            {
              "id": "ml_s1_swagam",
              "term": "സ്വാഗതം",
              "transliteration": "Swaagatham",
              "translation": "Welcome",
              "tags": [
                "S1",
                "polite"
              ],
              "example": {
                "term": "കേരളത്തിലേക്ക് സ്വാഗതം!",
                "translation": "Welcome to Kerala!"
              }
            },
            {
              "id": "ml_s1_varatte",
              "term": "ഞാൻ വരട്ടെ",
              "transliteration": "Njaan varatte",
              "translation": "I'll take my leave (lit. let me come back)",
              "tags": [
                "S1",
                "farewell"
              ],
              "example": {
                "term": "നേരമായി, ഞാൻ വരട്ടെ.",
                "translation": "It's getting late, I'll head out."
              }
            },
            {
              "id": "ml_s1_dayavayi",
              "term": "ദയവായി",
              "transliteration": "Dayavaayi",
              "translation": "Please (formal)",
              "tags": [
                "S1",
                "polite"
              ],
              "example": {
                "term": "ദയവായി ഇവിടെ ഇരിക്കൂ.",
                "translation": "Please sit here."
              }
            },
            {
              "id": "ml_s1_kuzhappamilla",
              "term": "കുഴപ്പമില്ല",
              "transliteration": "Kuzhappamilla",
              "translation": "No problem / It's fine",
              "tags": [
                "S1",
                "polite"
              ],
              "example": {
                "term": "കുഴപ്പമില്ല, മെല്ലെ മതി.",
                "translation": "No problem, take your time."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ml-s1-u2",
      "title": "Introductions & Family",
      "subtitle": "പരിചയവും കുടുംബവും · Pronouns, names, and relatives",
      "cefrLevel": "S1",
      "color": "#14b8a6",
      "lessons": [
        {
          "id": "ml-s1-u2-l1",
          "title": "Introducing Yourself",
          "objective": "Share your name and hometown cleanly.",
          "grammarNote": "Malayalam follows Subject-Object-Verb order. 'എന്റെ' (ente) means 'my'.",
          "items": [
            {
              "id": "ml_s1_njan",
              "term": "ഞാൻ",
              "transliteration": "Njaan",
              "translation": "I / Me",
              "tags": [
                "S1",
                "pronoun"
              ],
              "example": {
                "term": "ഞാൻ മലയാളം പഠിക്കുന്നു.",
                "translation": "I am learning Malayalam."
              }
            },
            {
              "id": "ml_s1_ningal",
              "term": "നിങ്ങൾ",
              "transliteration": "Ningal",
              "translation": "You (polite / plural)",
              "tags": [
                "S1",
                "pronoun"
              ],
              "example": {
                "term": "നിങ്ങൾ എവിടെ നിന്നാണ്?",
                "translation": "Where are you from?"
              }
            },
            {
              "id": "ml_s1_ente_peru",
              "term": "എന്റെ പേര്",
              "transliteration": "Ente peru",
              "translation": "My name",
              "tags": [
                "S1",
                "intro"
              ],
              "example": {
                "term": "എന്റെ പേര് മഹേഷ് എന്നാണ്.",
                "translation": "My name is Mahesh."
              }
            },
            {
              "id": "ml_s1_naadu",
              "term": "നാട്",
              "transliteration": "Naadu",
              "translation": "Hometown / Homeland",
              "tags": [
                "S1",
                "intro"
              ],
              "example": {
                "term": "നിങ്ങളുടെ നാട് എവിടെയാണ്?",
                "translation": "Where is your hometown?"
              }
            },
            {
              "id": "ml_s1_parichayam",
              "term": "പരിചയപ്പെട്ടതിൽ സന്തോഷം",
              "transliteration": "Parichayappettathil santhosham",
              "translation": "Nice to meet you",
              "tags": [
                "S1",
                "intro"
              ],
              "example": {
                "term": "നിങ്ങളെ പരിചയപ്പെട്ടതിൽ സന്തോഷം.",
                "translation": "Nice to meet you."
              }
            }
          ]
        },
        {
          "id": "ml-s1-u2-l2",
          "title": "My Family",
          "objective": "Name parents, siblings, and family.",
          "grammarNote": "Malayalam distinguishes older brother (ചേട്ടൻ) and older sister (ചേച്ചി), also used respectfully for strangers!",
          "items": [
            {
              "id": "ml_s1_kudumbam",
              "term": "കുടുംബം",
              "transliteration": "Kudumbam",
              "translation": "Family",
              "tags": [
                "S1",
                "family"
              ],
              "example": {
                "term": "എന്റെ കുടുംബം കൊച്ചിയിലാണ്.",
                "translation": "My family is in Kochi."
              }
            },
            {
              "id": "ml_s1_amma",
              "term": "അമ്മ",
              "transliteration": "Amma",
              "translation": "Mother",
              "tags": [
                "S1",
                "family"
              ],
              "example": {
                "term": "അമ്മ നല്ല ഭക്ഷണം ഉണ്ടാക്കും.",
                "translation": "Mom makes great food."
              }
            },
            {
              "id": "ml_s1_achan",
              "term": "അച്ഛൻ",
              "transliteration": "Achhan",
              "translation": "Father",
              "tags": [
                "S1",
                "family"
              ],
              "example": {
                "term": "അച്ഛൻ രാവിലെ പത്രം വായിക്കും.",
                "translation": "Dad reads the newspaper in the morning."
              }
            },
            {
              "id": "ml_s1_chettan",
              "term": "ചേട്ടൻ",
              "transliteration": "Chettan",
              "translation": "Older brother (also respectful 'sir')",
              "tags": [
                "S1",
                "family"
              ],
              "example": {
                "term": "ചേട്ടാ, ഒരു ചായ തരാമോ?",
                "translation": "Brother, could you give me a tea?"
              }
            },
            {
              "id": "ml_s1_chechi",
              "term": "ചേച്ചി",
              "transliteration": "Chechi",
              "translation": "Older sister (also respectful 'ma'am')",
              "tags": [
                "S1",
                "family"
              ],
              "example": {
                "term": "ചേച്ചി എവിടെയാണ് ജോലി ചെയ്യുന്നത്?",
                "translation": "Where does sister work?"
              }
            }
          ]
        },
        {
          "id": "ml-s1-u2-l3",
          "title": "Friends & People",
          "objective": "Talk about friends, teachers, and students.",
          "grammarNote": "Use 'അവൻ' (he), 'അവൾ' (she), 'അവർ' (they / polite he or she).",
          "items": [
            {
              "id": "ml_s1_kootukaran",
              "term": "കൂട്ടുകാരൻ / കൂട്ടുകാരി",
              "transliteration": "Koottukaaran / Koottukaari",
              "translation": "Friend",
              "tags": [
                "S1",
                "people"
              ],
              "example": {
                "term": "അവൻ എന്റെ അടുത്ത കൂട്ടുകാരനാണ്.",
                "translation": "He is my close friend."
              }
            },
            {
              "id": "ml_s1_adhyapakan",
              "term": "അധ്യാപകൻ / അധ്യാപിക",
              "transliteration": "Adhyaapakan / Adhyaapika",
              "translation": "Teacher",
              "tags": [
                "S1",
                "people"
              ],
              "example": {
                "term": "അധ്യാപിക വളരെ നന്നായി പഠിപ്പിക്കുന്നു.",
                "translation": "The teacher teaches very well."
              }
            },
            {
              "id": "ml_s1_vidyarthi",
              "term": "വിദ്യാർത്ഥി",
              "transliteration": "Vidyaarthi",
              "translation": "Student",
              "tags": [
                "S1",
                "people"
              ],
              "example": {
                "term": "ഞാൻ ഒരു വിദ്യാർത്ഥിയാണ്.",
                "translation": "I am a student."
              }
            },
            {
              "id": "ml_s1_avar",
              "term": "അവർ",
              "transliteration": "Avar",
              "translation": "They / He or She (respectful)",
              "tags": [
                "S1",
                "pronoun"
              ],
              "example": {
                "term": "അവർ ഇന്ന് വരും.",
                "translation": "They will come today."
              }
            },
            {
              "id": "ml_s1_nammal",
              "term": "നമ്മൾ",
              "transliteration": "Nammal",
              "translation": "We (inclusive)",
              "tags": [
                "S1",
                "pronoun"
              ],
              "example": {
                "term": "നമ്മൾ ഒരുമിച്ച് പഠിക്കാം.",
                "translation": "Let's study together."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ml-s1-u3",
      "title": "Numbers, Time & Days",
      "subtitle": "സംഖ്യകളും സമയവും · Counting and telling time",
      "cefrLevel": "S1",
      "color": "#0ea5e9",
      "lessons": [
        {
          "id": "ml-s1-u3-l1",
          "title": "Numbers 1 to 5",
          "objective": "Count your first five Malayalam numbers.",
          "grammarNote": "Before a noun, ഒന്ന് (onnu) becomes ഒരു (oru = one / a): ഒരു പുസ്തകം (one book).",
          "items": [
            {
              "id": "ml_s1_onnu",
              "term": "ഒന്ന്",
              "transliteration": "Onnu",
              "translation": "One (1)",
              "tags": [
                "S1",
                "number"
              ],
              "example": {
                "term": "ഒരു നിമിഷം കാത്തിരിക്കൂ.",
                "translation": "Wait one moment."
              }
            },
            {
              "id": "ml_s1_randu",
              "term": "രണ്ട്",
              "transliteration": "Randu",
              "translation": "Two (2)",
              "tags": [
                "S1",
                "number"
              ],
              "example": {
                "term": "രണ്ട് ടിക്കറ്റ് വേണം.",
                "translation": "I need two tickets."
              }
            },
            {
              "id": "ml_s1_moonnu",
              "term": "മൂന്ന്",
              "transliteration": "Moonnu",
              "translation": "Three (3)",
              "tags": [
                "S1",
                "number"
              ],
              "example": {
                "term": "മൂന്ന് മണിക്ക് കാണാം.",
                "translation": "Let's meet at three o'clock."
              }
            },
            {
              "id": "ml_s1_naalu",
              "term": "നാല്",
              "transliteration": "Naalu",
              "translation": "Four (4)",
              "tags": [
                "S1",
                "number"
              ],
              "example": {
                "term": "നാല് പേർ വരുന്നുണ്ട്.",
                "translation": "Four people are coming."
              }
            },
            {
              "id": "ml_s1_anju",
              "term": "അഞ്ച്",
              "transliteration": "Anju",
              "translation": "Five (5)",
              "tags": [
                "S1",
                "number"
              ],
              "example": {
                "term": "അഞ്ച് മിനിറ്റ് മതി.",
                "translation": "Five minutes is enough."
              }
            }
          ]
        },
        {
          "id": "ml-s1-u3-l2",
          "title": "Higher Numbers & Time",
          "objective": "Handle tens, hundreds, and asking the time.",
          "grammarNote": "Add മണി (mani) to numbers to tell the hour: പത്ത് മണി (10 o'clock).",
          "items": [
            {
              "id": "ml_s1_pathu",
              "term": "പത്ത്",
              "transliteration": "Pathu",
              "translation": "Ten (10)",
              "tags": [
                "S1",
                "number"
              ],
              "example": {
                "term": "ദിവസവും പത്ത് മിനിറ്റ് പഠിക്കുക.",
                "translation": "Study ten minutes daily."
              }
            },
            {
              "id": "ml_s1_nooru",
              "term": "നൂറ്",
              "transliteration": "Nooru",
              "translation": "Hundred (100)",
              "tags": [
                "S1",
                "number"
              ],
              "example": {
                "term": "ഇതിന് നൂറ് രൂപയാണ്.",
                "translation": "This costs 100 rupees."
              }
            },
            {
              "id": "ml_s1_samayam",
              "term": "സമയം",
              "transliteration": "Samayam",
              "translation": "Time",
              "tags": [
                "S1",
                "time"
              ],
              "example": {
                "term": "ഇപ്പോൾ സമയം എത്രയായി?",
                "translation": "What time is it now?"
              }
            },
            {
              "id": "ml_s1_ravile",
              "term": "രാവിലെ",
              "transliteration": "Raavile",
              "translation": "In the morning",
              "tags": [
                "S1",
                "time"
              ],
              "example": {
                "term": "രാവിലെ നടക്കാൻ പോകും.",
                "translation": "I go for a walk in the morning."
              }
            },
            {
              "id": "ml_s1_rathri",
              "term": "രാത്രി",
              "transliteration": "Raathri",
              "translation": "Night",
              "tags": [
                "S1",
                "time"
              ],
              "example": {
                "term": "രാത്രി നേരത്തെ ഉറങ്ങണം.",
                "translation": "Should sleep early at night."
              }
            }
          ]
        },
        {
          "id": "ml-s1-u3-l3",
          "title": "Yesterday, Today & Tomorrow",
          "objective": "Talk about days and weekly schedules.",
          "grammarNote": "Use ഇന്ന് (today), നാളെ (tomorrow), and ഇന്നലെ (yesterday) to anchor tenses.",
          "items": [
            {
              "id": "ml_s1_innale",
              "term": "ഇന്നലെ",
