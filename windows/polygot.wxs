<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Polygot"
           Manufacturer="mahesh-labs"
           Version="$(var.MsiVersion)"
           UpgradeCode="C8E4B29A-3D71-4F62-9A14-6E8B2C5D3F91"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Polygot is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="PolygotIcon.ico" SourceFile="polygot.ico" />
    <Property Id="ARPPRODUCTICON" Value="PolygotIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://mahesh-labs.github.io/polygot/" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Polygot" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Polygot" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="ProductFeature" Title="Polygot" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="dist\stage-msi\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="D1F5A82B-4E9C-4A73-8B25-7F9C3D6E4A02">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="Polygot"
                Description="Free and open-source language learning app"
                Target="[INSTALLFOLDER]Polygot.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="PolygotIcon.ico" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Polygot" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="E2A6B93C-5FAD-4B84-9C36-8A0D4E7F5B13">
      <Shortcut Id="ApplicationDesktopShortcut"
                Name="Polygot"
                Description="Free and open-source language learning app"
                Target="[INSTALLFOLDER]Polygot.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="PolygotIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\Polygot" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
