{
  "name": "openlingo",
  "version": "1.0.0",
  "private": true,
  "description": "Free & open-source cross-platform language learning app (Web PWA + Capacitor Mobile + Tauri Desktop)",
  "scripts": {
    "web:dev": "python3 -m http.server 8080",
    "cap:init": "npx cap init OpenLingo org.openlingo.app --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
