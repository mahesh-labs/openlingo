{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polygot",
  "version": "1.0.0",
  "identifier": "org.polygot.app",
  "build": {
    "frontendDist": "..",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "title": "Polygot — Free & Open-Source Language Learning",
        "width": 1120,
        "height": 760,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
