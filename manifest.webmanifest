{
  "name": "OpenLingo — Free & Open-Source Language Learning",
  "short_name": "OpenLingo",
  "description": "Community-driven, cross-platform language learning app with structured syllabi, handwriting canvas, spaced-repetition flashcards, and private Google Drive sync.",
  "start_url": "./index.html",
